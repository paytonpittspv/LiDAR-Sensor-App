// ---------------- settings ----------------
static const char*    FW_VERSION    = "v4.0";
static const char*    AP_SSID       = "SpeedLidar";
static const char*    AP_PASS       = "vault1234";   // 8+ characters; also the Wi-Fi update password
static const int      MAX_DEVICES   = 6;             // phones/iPads on the sensor's Wi-Fi at once
static const int      PIN_LIDAR_RX  = 18;            // S3 receives on this pin (TF03 TX, brown)
static const int      PIN_LIDAR_TX  = 17;            // S3 sends on this pin (TF03 RX, blue)
// screen
static const int      PIN_TFT_SCK   = 12, PIN_TFT_MOSI = 11, PIN_TFT_RST = 10, PIN_TFT_DC = 9, PIN_TFT_CS = 8, PIN_TFT_BL = 7;
static const bool     SCREEN_FLIP   = false;         // upside down in the case? set true
static const bool     SCREEN_BGR    = false;         // red and blue swapped? set true
static const bool     SCREEN_INVERT = true;          // colours look like a negative? set false
static const uint32_t SCREEN_SPI_HZ = 40000000;
// LiDAR
static const uint16_t FRAME_RATE_HZ = 1000;          // readings per second
static const uint16_t MAX_VALID_CM  = 9900;          // TF03-100: 9900, TF03-180: 17900
static const uint32_t MAX_SAMPLES   = 120000;        // 2 minutes at 1000 Hz (in PSRAM: room for a 100 m)
static const uint32_t STOP_WINDOW   = 1500;          // 1.5 s with no target / no movement ends a run
static const uint16_t MOVE_START_CM = 250;           // run "starts" when you gain 2.5 m...
static const uint32_t MOVE_WINDOW   = 500;           // ...within 0.5 s (5 m/s) — walking or jogging won't trigger it
static const uint32_t PRE_ROLL      = 2000;          // keep 2 s of data before the run starts
static const uint16_t STILL_CM      = 40;            // "standing still" = staying within ±40 cm
static const uint32_t STILL_GAP_MS  = 150;           // short dropouts allowed while standing (arm swing, a pole)
static const uint32_t AWAY_MS       = 1500;          // armed but nobody at the start for this long → wait again
// The sensor's own web address. The S3 answers this name itself on its Wi-Fi (no internet needed) and
// serves the app over https with a real certificate, so phones keep the app for offline use.
static const char*    HOST          = "sensor.paytonpittsdesigns.com";

// a file the sensor serves (the app page is stored gzipped)
struct Asset { const char* type; const uint8_t* data; size_t len; const char* cache; bool gz; };

// states the phones see
enum { ST_IDLE = 0, ST_WAIT = 1, ST_SET = 2, ST_RUN = 3, ST_DONE = 4 };

static String urlDecode(const char* s) {
  String o; o.reserve(strlen(s));
  while (*s) {
    if (*s == '+') { o += ' '; s++; }
    else if (*s == '%' && isxdigit((uint8_t)s[1]) && isxdigit((uint8_t)s[2])) { char h[3] = {s[1], s[2], 0}; o += (char)strtol(h, nullptr, 16); s += 3; }
    else o += *s++;
  }
  return o;
}
// request parameters, from either server (query string and/or a form-encoded POST body)
struct Params {
  WebServer* ws = nullptr; String raw;
  bool has(const char* k) const {
    if (ws) return ws->hasArg(k);
    char v[4]; esp_err_t e = httpd_query_key_value(raw.c_str(), k, v, sizeof v); return e == ESP_OK || e == ESP_ERR_HTTPD_RESULT_TRUNC;
  }
  String get(const char* k, const char* dflt = "") const {
    if (ws) return ws->hasArg(k) ? ws->arg(k) : String(dflt);
    static char v[768];
    if (httpd_query_key_value(raw.c_str(), k, v, sizeof v) != ESP_OK) return String(dflt);
    return urlDecode(v);
  }
  long num(const char* k, long dflt) const { String s = get(k); return s.length() ? s.toInt() : dflt; }
};

// One reading: its time on the S3 (µs), distance (cm) and signal strength. 8 bytes, kept in PSRAM.
struct Sample { uint32_t t; uint16_t d; uint16_t s; };
Sample* sBuf = nullptr;

volatile uint8_t  state     = ST_IDLE;
volatile uint32_t sets      = 0;      // how many times it has armed (the phones chime when this goes up)
volatile uint32_t nSamples  = 0;
volatile uint32_t goIdx     = 0;      // sample index where the run was confirmed
volatile bool     recording = false;
volatile bool     moved     = false;
volatile bool     resetRun  = false;
volatile bool     resetWait = false;
volatile uint32_t stopCm    = 0;      // sprint: stop this far past the start position (0 = stop on its own)
volatile uint16_t limitCm   = MAX_VALID_CM;   // vault: nothing at or past the box is used
volatile uint16_t gateCm    = 0;      // standing only counts closer than this (0 = anywhere)
volatile uint32_t holdMs    = 1500;   // how long to stand still to arm
volatile float    holdFrac  = 0;      // how far through the stand-still they are (0–1), for the screen
volatile uint16_t liveDist  = 0;
volatile uint16_t liveStr   = 0;
volatile uint32_t liveRate  = 0;
volatile uint8_t  liveSig   = 0;      // % of readings in the last quarter second that hit something usable
volatile uint32_t badFrames = 0;

// ---- shared between the phones: who set up the current run, and its result for the screen ----
// Every /arm gets a number. The phone that armed sends its setup (cfg, JSON the app reads back); the other
// phones see the new number in /live, copy the setup and record the same run.
SemaphoreHandle_t uiLock;
volatile uint32_t armId = 0;
String  armCfg = "";                  // JSON from the app that armed (athlete, test), passed on to the others
char    armWho[24] = "", armEvS[24] = "", armEvL[32] = "";
float   armTarget = 0;                // sprint: target distance (m) for the screen's progress bar
volatile uint32_t showArm = 0;        // the run the screen result belongs to
volatile uint32_t showAt  = 0;
scr::Model resultModel;               // filled by /show (from the app, once it has worked the run out)
volatile bool     updating = false;
volatile int      updatePct = 0;

static inline bool validCm(uint16_t d) { return d > 10 && d < limitCm; }

// ---------------- arming: an athlete has to stand still at the start ----------------
// returns true once someone has stood within the gate, still, for holdMs
bool standCheck(uint32_t nowMs, uint16_t d) {
  static uint16_t anchor = 0, off = 0;
  static uint32_t since = 0, lastOk = 0;
  if (resetWait) { resetWait = false; anchor = 0; since = 0; lastOk = 0; off = 0; }
  bool inZone = validCm(d) && (gateCm == 0 || d < gateCm);
  if (!inZone) {
    if (since && nowMs - lastOk > STILL_GAP_MS) { since = 0; holdFrac = 0; }   // left, or someone walked through
    return false;
  }
  lastOk = nowMs;
  if (!since) { anchor = d; since = nowMs; off = 0; holdFrac = 0; return false; }
  if (d > anchor + STILL_CM || d + STILL_CM < anchor) {
    // one odd reading (arm, pole, noise) doesn't count; 60 ms in a row away from the spot means they moved
    if (++off > 60) { anchor = d; since = nowMs; off = 0; holdFrac = 0; }
    return false;
  }
  off = 0;
  float f = (float)(nowMs - since) / holdMs; holdFrac = f > 1 ? 1 : f;
  return nowMs - since >= holdMs;
}

// ---------------- recording ----------------
void storeSample(uint32_t now, uint16_t d, uint16_t s) {
  static uint32_t lostCount = 0;
  static uint16_t fastCount = 0;   // consecutive readings that look like sprinting
  static uint32_t stopAt    = 0;   // distance (cm) where a sprint test ends
  static uint32_t tail      = 0;   // readings kept after the target, so the finish isn't cut short
  static uint32_t away      = 0;   // armed, but nobody standing at the start
  static uint16_t backCnt   = 0;

  if (resetRun) {               // armed: start a fresh buffer
    resetRun = false;
    nSamples = 0; moved = false; lostCount = 0; fastCount = 0; stopAt = 0; tail = 0; away = 0; goIdx = 0; backCnt = 0;
  }
  if (nSamples >= MAX_SAMPLES) { recording = false; state = ST_DONE; return; }

  sBuf[nSamples] = {now, d, s};
  nSamples++;

  if (validCm(d)) {
    lostCount = 0;
    if (!moved && nSamples > MOVE_WINDOW) {
      uint16_t back = sBuf[nSamples - 1 - MOVE_WINDOW].d;
      if (validCm(back) && d > back + MOVE_START_CM) {
        if (++fastCount >= 50) {
          moved = true; state = ST_RUN; goIdx = nSamples;
          if (stopCm) {
            // start position = closest reading in the 1.5 s before the run was confirmed
            uint16_t start = 0xFFFF;
            uint32_t from = nSamples > 1500 ? nSamples - 1500 : 0;
            for (uint32_t i = from; i < nSamples; i++) { uint16_t x = sBuf[i].d; if (validCm(x) && x < start) start = x; }
            stopAt = (start == 0xFFFF ? back : start) + stopCm;
          }
        }
      }
      else fastCount = 0;
    }
  } else {
    lostCount++;
  }

  if (!moved) {
    // Armed and waiting at the start. If the athlete walks off (or out of the zone) instead of running,
    // go back to waiting so the next person has to stand in again. There's no time limit while they stay.
    bool atStart = validCm(d) && (gateCm == 0 || d < gateCm + 200);
    // (a stray close reading doesn't count as being back at the start: needs 30 ms in a row)
    if (atStart) { if (++backCnt > 30) away = 0; } else { backCnt = 0; away++; }
    if (away >= AWAY_MS) { recording = false; resetWait = true; state = ST_WAIT; return; }
    // only keep the most recent PRE_ROLL samples
    if (nSamples >= PRE_ROLL + 1000) {
      memmove(sBuf, sBuf + 1000, (nSamples - 1000) * sizeof(Sample));
      nSamples -= 1000;
    }
    return;
  }

  // Sprint test: past the target distance → keep 0.3 s more, then stop.
  if (stopAt && validCm(d) && d >= stopAt) tail++;
  if (tail >= 300) { recording = false; state = ST_DONE; return; }

  // Run in progress: stop when the target is lost or nothing moves for 1.5 s
  // (vault: after takeoff the athlete is past the box, which counts as lost).
  if (lostCount >= STOP_WINDOW) { recording = false; state = ST_DONE; return; }
  if (nSamples > STOP_WINDOW && nSamples % 100 == 0 && validCm(d)) {
    uint32_t off = 0;
    for (uint32_t i = nSamples - STOP_WINDOW; i < nSamples; i++) {
      uint16_t x = sBuf[i].d;
      if (!validCm(x) || x > d + 30 || x + 30 < d) off++;
    }
    if (off < STOP_WINDOW / 20) { recording = false; state = ST_DONE; }
  }
}

// one reading from the sensor
void onFrame(uint32_t nowUs, uint16_t d, uint16_t s) {
  if (state == ST_WAIT && standCheck(nowUs / 1000, d)) {
    resetRun = true; recording = true; state = ST_SET; sets++; holdFrac = 0;
  }
  if (recording) storeSample(nowUs, d, s);
}

// ---------------- LiDAR reader (own task so Wi-Fi never delays it) ----------------
void lidarTask(void*) {
  uint8_t  buf[9];
  int      idx = 0;
  uint32_t frames = 0, sigN = 0, sigOk = 0;
  uint32_t rateT0 = micros(), sigT0 = rateT0;

  for (;;) {
    while (Serial1.available()) {
      uint8_t b = Serial1.read();
      if (idx == 0 && b != 0x59) continue;            // frame header 0x59 0x59
      if (idx == 1 && b != 0x59) { idx = 0; continue; }
      buf[idx++] = b;
      if (idx < 9) continue;
      idx = 0;

      uint8_t sum = 0;
      for (int i = 0; i < 8; i++) sum += buf[i];
      if (sum != buf[8]) { badFrames++; continue; }

      uint32_t now = micros();
      uint16_t d = buf[2] | (buf[3] << 8);
      uint16_t s = buf[4] | (buf[5] << 8);
      liveDist = d;
      liveStr  = s;
      frames++; sigN++; if (validCm(d)) sigOk++;
      onFrame(now, d, s);
    }
    uint32_t now = micros();
    if (now - rateT0 >= 1000000) { liveRate = frames; frames = 0; rateT0 = now; }
    if (now - sigT0 >= 250000) { liveSig = sigN ? (uint8_t)(100 * sigOk / sigN) : 0; sigN = sigOk = 0; sigT0 = now; }
    vTaskDelay(1);
  }
}

void configureLidar() {
  // Set frame rate: 5A 06 03 LL HH checksum (not saved to flash; sent every boot)
  uint8_t cmd[6] = {0x5A, 0x06, 0x03, (uint8_t)(FRAME_RATE_HZ & 0xFF), (uint8_t)(FRAME_RATE_HZ >> 8), 0};
  uint8_t sum = 0;
  for (int i = 0; i < 5; i++) sum += cmd[i];
  cmd[5] = sum;
  Serial1.write(cmd, sizeof(cmd));
  delay(100);
  while (Serial1.available()) Serial1.read();   // discard the reply
}

// ---------------- the screen (ST7789, 170 × 320, used sideways) ----------------
SPIClass tftSpi(FSPI);
static uint8_t* lineBuf = nullptr;   // one row, byte-swapped for the panel (internal RAM)

static void tftCmd(uint8_t c, const uint8_t* data = nullptr, size_t n = 0) {
  digitalWrite(PIN_TFT_DC, LOW); digitalWrite(PIN_TFT_CS, LOW);
  tftSpi.transfer(c);
  if (n) { digitalWrite(PIN_TFT_DC, HIGH); tftSpi.writeBytes(data, n); }
  digitalWrite(PIN_TFT_CS, HIGH);
}
static void tftInit() {
  pinMode(PIN_TFT_CS, OUTPUT); pinMode(PIN_TFT_DC, OUTPUT); pinMode(PIN_TFT_RST, OUTPUT); pinMode(PIN_TFT_BL, OUTPUT);
  digitalWrite(PIN_TFT_CS, HIGH); digitalWrite(PIN_TFT_BL, LOW);
  tftSpi.begin(PIN_TFT_SCK, -1, PIN_TFT_MOSI, -1);
  tftSpi.beginTransaction(SPISettings(SCREEN_SPI_HZ, MSBFIRST, SPI_MODE0));   // only the screen uses this bus
  digitalWrite(PIN_TFT_RST, HIGH); delay(5); digitalWrite(PIN_TFT_RST, LOW); delay(20); digitalWrite(PIN_TFT_RST, HIGH); delay(150);
  tftCmd(0x01); delay(150);                         // software reset
  tftCmd(0x11); delay(120);                         // wake up
  uint8_t colmod = 0x55; tftCmd(0x3A, &colmod, 1);  // 16-bit colour
  // sideways: MV (+ MX, or MY for upside down); RGB/BGR order
  uint8_t mad = (SCREEN_FLIP ? 0xA0 : 0x60) | (SCREEN_BGR ? 0x08 : 0x00); tftCmd(0x36, &mad, 1);
  tftCmd(SCREEN_INVERT ? 0x21 : 0x20);
  tftCmd(0x13); tftCmd(0x29); delay(20);
  lineBuf = (uint8_t*)heap_caps_malloc(scr::W * 2, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
}
static void tftPush() {
  // 320 × 170 in landscape: the 170-pixel side sits 35 rows into the controller's 240-row memory
  const uint16_t x0 = 0, x1 = scr::W - 1, y0 = 35, y1 = 35 + scr::H - 1;
  uint8_t ca[4] = {(uint8_t)(x0 >> 8), (uint8_t)x0, (uint8_t)(x1 >> 8), (uint8_t)x1}; tftCmd(0x2A, ca, 4);
  uint8_t ra[4] = {(uint8_t)(y0 >> 8), (uint8_t)y0, (uint8_t)(y1 >> 8), (uint8_t)y1}; tftCmd(0x2B, ra, 4);
  digitalWrite(PIN_TFT_DC, LOW); digitalWrite(PIN_TFT_CS, LOW); tftSpi.transfer(0x2C); digitalWrite(PIN_TFT_DC, HIGH);
  for (int y = 0; y < scr::H; y++) {
    const uint16_t* row = scr::fb + y * scr::W;
    for (int x = 0; x < scr::W; x++) { lineBuf[2 * x] = row[x] >> 8; lineBuf[2 * x + 1] = row[x] & 0xFF; }
    tftSpi.writeBytes(lineBuf, scr::W * 2);
  }
  digitalWrite(PIN_TFT_CS, HIGH);
}

// live speed for the screen: straight-line fit of distance against time over the last 0.3 s
static float liveSpeed(uint32_t n) {
  if (n < 50) return 0;
  uint32_t tEnd = sBuf[n - 1].t; double st = 0, sd = 0, stt = 0, std_ = 0; int m = 0;
  for (uint32_t i = n; i-- > 0 && m < 400;) {
    const Sample& p = sBuf[i]; if (tEnd - p.t > 300000) break;
    if (!validCm(p.d)) continue;
    double t = (int32_t)(p.t - tEnd) / 1e6, d = p.d / 100.0; st += t; sd += d; stt += t * t; std_ += t * d; m++;
  }
  if (m < 20) return 0;
  double den = m * stt - st * st; if (den <= 0) return 0;
  double v = (m * std_ - st * sd) / den; return v > 0 && v < 15 ? (float)v : 0;
}

void screenTask(void*) {
  static scr::Model M;
  M.ssid = AP_SSID; M.pass = AP_PASS; M.host = HOST;
  static char fw[32]; snprintf(fw, sizeof fw, "%s \xC2\xB7 S3 \xC2\xB7 %s", FW_VERSION, "secure"); M.fw = fw;
  uint32_t boot = millis(), since = millis(), phonesAt = 0, runStartCm = 0;
  scr::Screen last = scr::S_BOOT; float vSmooth = 0; bool lidarSeen = false;
  digitalWrite(PIN_TFT_BL, HIGH);
  for (;;) {
    uint32_t now = millis();
    if (now - phonesAt > 500) { M.phones = WiFi.softAPgetStationNum(); phonesAt = now; }
    M.sig = liveSig;
    uint16_t d = liveDist;
    M.distOk = validCm(d); M.dist = d / 100.f;
    M.inZone = M.distOk && (gateCm == 0 || d < gateCm); M.hold = holdFrac;
    if (liveRate > 0) lidarSeen = true;
    uint8_t st = state;
    xSemaphoreTake(uiLock, portMAX_DELAY);
    M.armedCfg = armId > 0 && st != ST_IDLE;
    strlcpy(M.who, armWho, sizeof M.who); strlcpy(M.evShort, armEvS, sizeof M.evShort); strlcpy(M.evLine, armEvL, sizeof M.evLine);
    M.vault = stopCm == 0;
    float target = armTarget;
    bool haveResult = showArm == armId && showArm;
    if (haveResult) {
      memcpy(M.strip, resultModel.strip, sizeof M.strip); memcpy(M.head, resultModel.head, sizeof M.head);
      memcpy(M.headV, resultModel.headV, sizeof M.headV); memcpy(M.headU, resultModel.headU, sizeof M.headU);
      memcpy(M.cells, resultModel.cells, sizeof M.cells); M.nCells = resultModel.nCells;
      memcpy(M.footL, resultModel.footL, sizeof M.footL); memcpy(M.footR, resultModel.footR, sizeof M.footR);
    }
    // a result stays up after the next run is set up, until someone stands in to arm (or 3 minutes pass)
    bool holdResult = showArm && showAt && now - showAt < 180000 && !(M.inZone && M.hold > .15f);
    xSemaphoreGive(uiLock);

    scr::Screen s;
    if (updating) { s = scr::S_UPDATE; M.updatePct = updatePct; }
    else if (now - boot < 2200) s = scr::S_BOOT;
    else if (!lidarSeen || liveRate == 0) s = now - boot < 4000 ? scr::S_BOOT : scr::S_NOLIDAR;
    else if (st == ST_SET) s = scr::S_ARMED;
    else if (st == ST_RUN) s = scr::S_REC;
    else if (st == ST_DONE) s = haveResult ? scr::S_RESULT : scr::S_SAVING;
    else if (holdResult && (st == ST_WAIT || st == ST_IDLE)) {
      s = scr::S_RESULT;
      if (!haveResult) {   // the result belongs to the previous run: show the copy we kept
        xSemaphoreTake(uiLock, portMAX_DELAY);
        memcpy(M.strip, resultModel.strip, sizeof M.strip); memcpy(M.head, resultModel.head, sizeof M.head);
        memcpy(M.headV, resultModel.headV, sizeof M.headV); memcpy(M.headU, resultModel.headU, sizeof M.headU);
        memcpy(M.cells, resultModel.cells, sizeof M.cells); M.nCells = resultModel.nCells;
        memcpy(M.footL, resultModel.footL, sizeof M.footL); memcpy(M.footR, resultModel.footR, sizeof M.footR);
        M.vault = resultModel.vault;
        xSemaphoreGive(uiLock);
      }
    }
    else if (M.phones == 0 && st == ST_IDLE) s = scr::S_WIFI;
    else s = scr::S_READY;

    if (s == scr::S_REC) {
      uint32_t n = nSamples, g = goIdx;
      if (last != scr::S_REC) {
        // where they started: closest reading in the 1.5 s before the run was confirmed
        uint16_t start = 0xFFFF; for (uint32_t i = g > 1500 ? g - 1500 : 0; i < g && i < n; i++) if (validCm(sBuf[i].d) && sBuf[i].d < start) start = sBuf[i].d;
        runStartCm = start == 0xFFFF ? d : start; vSmooth = 0;
      }
      float v = liveSpeed(n); vSmooth = vSmooth ? .6f * vSmooth + .4f * v : v;
      M.speed = vSmooth;
      M.runDist = M.distOk && d > runStartCm ? (d - runStartCm) / 100.f : M.runDist;
      M.runTarget = M.vault ? (limitCm > runStartCm ? (limitCm - runStartCm) / 100.f : 0) : target;
      M.runTime = n && g && g <= n ? (sBuf[n - 1].t - sBuf[g - 1].t) / 1e6f : 0;
    }
    if (s != last) { last = s; since = now; }
    M.screen = s; M.t = now - since;
    scr::draw(M);
    tftPush();
    vTaskDelay(pdMS_TO_TICKS(40));
  }
}

// ---------------- web ----------------
// Two servers share the same handlers:
//   https://sensor.paytonpittsdesigns.com  the app (once a certificate is installed). Several phones/iPads at once:
//                                          the S3 keeps each secure connection's memory in PSRAM.
//   http://192.168.4.1                     setup and fallback: same app and data, plus the certificate setup.
WebServer server(80);
DNSServer dns;
Preferences prefs;
httpd_handle_t https = nullptr;
String keyPem, crtPem;
char certUntil[24] = "";          // the installed certificate's expiry, "YYYY-MM-DDTHH:MM:SSZ" ("" = none)
volatile uint32_t restartHttpsAt = 0, rebootAt = 0;
mbedtls_entropy_context entropy;
mbedtls_ctr_drbg_context drbg;

static void jsonEscape(String& out, const String& s) {
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') { out += '\\'; out += c; }
    else if ((uint8_t)c < 0x20) { char b[8]; snprintf(b, sizeof b, "\\u%04x", c); out += b; }
    else out += c;
  }
}

// ---- the shared bits of each request ----
// /live: sensor status; with from=N also the run so far (up to 150 points, every 20th reading)
size_t buildLive(char* json, size_t cap, long from) {
  uint16_t d = liveDist;
  int len = snprintf(json, cap,
           "{\"d\":%u,\"s\":%u,\"rate\":%lu,\"rec\":%s,\"moved\":%s,\"n\":%lu,\"bad\":%lu,\"max\":%u,\"state\":%u,\"sets\":%lu,\"go\":%lu,\"in\":%s,\"secure\":%s,"
           "\"arm\":%lu,\"phones\":%d,\"fw\":\"%s\",\"show\":%lu,\"cfg\":",
           d, liveStr, (unsigned long)liveRate, recording ? "true" : "false", moved ? "true" : "false",
           (unsigned long)nSamples, (unsigned long)badFrames, (unsigned)limitCm, (unsigned)state, (unsigned long)sets, (unsigned long)goIdx,
           (validCm(d) && (gateCm == 0 || d < gateCm)) ? "true" : "false", certUntil[0] ? "true" : "false",
           (unsigned long)armId, WiFi.softAPgetStationNum(), FW_VERSION, (unsigned long)showArm);
  {
    String c = "\"";
    xSemaphoreTake(uiLock, portMAX_DELAY); jsonEscape(c, armCfg); xSemaphoreGive(uiLock);
    c += "\"";
    len += snprintf(json + len, cap - len, "%s", c.c_str());
  }
  if (from >= 0 && (state == ST_RUN || state == ST_DONE) && nSamples) {
    uint32_t n = nSamples, t0 = sBuf[0].t;
    uint32_t i = (uint32_t)from, k = 0;
    len += snprintf(json + len, cap - len, ",\"t0\":%lu,\"pts\":[", (unsigned long)t0);
    for (; i < n && k < 150 && len < (int)cap - 40; i += 20, k++) {
      len += snprintf(json + len, cap - len, "%s[%lu,%u]", k ? "," : "", (unsigned long)((sBuf[i].t - t0) / 1000), sBuf[i].d);
    }
    len += snprintf(json + len, cap - len, "],\"next\":%lu", (unsigned long)i);
  }
  len += snprintf(json + len, cap - len, "}");
  return len;
}
// /arm?stop=3150&gate=500&hold=1500&max=9900[&now=1]  (GET, or POST with the same as a form)
//   stop: sprint ends this far (cm) past the start (0 = vault, stops by itself)
//   gate: athlete must stand closer than this (cm) to arm (0 = anywhere)
//   hold: how long to stand still (ms) · max: ignore everything at or past this (cm), e.g. the box
//   now: skip the stand-still check and arm straight away
//   cfg: the run's setup as JSON (passed on to the other phones) · who, evs, evl, tgt: for the screen
String apiArm(const Params& p) {
  recording = false;
  delay(5);
  long stop = p.num("stop", 0), gate = p.num("gate", 0), hold = p.num("hold", 1500), mx = p.num("max", MAX_VALID_CM);
  stopCm  = stop > 0 ? (uint32_t)stop : 0;
  gateCm  = gate > 0 ? (uint16_t)gate : 0;
  holdMs  = hold > 0 ? (uint32_t)hold : 1500;
  limitCm = (uint16_t)(mx > 10 && mx < MAX_VALID_CM ? mx : MAX_VALID_CM);
  nSamples = 0; moved = false; goIdx = 0; holdFrac = 0;
  xSemaphoreTake(uiLock, portMAX_DELAY);
  armCfg = p.get("cfg"); if (armCfg.length() > 600) armCfg = "";
  strlcpy(armWho, p.get("who").c_str(), sizeof armWho);
  strlcpy(armEvS, p.get("evs", stopCm ? "SPRINT" : "VAULT").c_str(), sizeof armEvS);
  strlcpy(armEvL, p.get("evl").c_str(), sizeof armEvL);
  armTarget = p.get("tgt", "0").toFloat();
  uint32_t id = ++armId;
  xSemaphoreGive(uiLock);
  resetWait = true;
  if (p.has("now") && p.num("now", 1) != 0) { resetRun = true; recording = true; state = ST_SET; sets++; }
  else state = ST_WAIT;
  return String("{\"ok\":true,\"arm\":") + id + "}";
}
void doStop() { recording = false; state = ST_IDLE; holdFrac = 0; }
// /show (POST form): the result for the screen, sent by the phone that worked the run out
//   run: the arm number it belongs to · strip, h, hv, hu: heading, big number and its unit
//   k1..k4, v1..v4, u1..u4: up to four smaller values · fl, fr: footer left/right
String apiShow(const Params& p) {
  uint32_t run = p.num("run", 0);
  if (!run) return "{\"ok\":false}";
  xSemaphoreTake(uiLock, portMAX_DELAY);
  scr::Model& R = resultModel;
  strlcpy(R.strip, p.get("strip", "RUN SAVED").c_str(), sizeof R.strip);
  strlcpy(R.head, p.get("h").c_str(), sizeof R.head); strlcpy(R.headV, p.get("hv").c_str(), sizeof R.headV); strlcpy(R.headU, p.get("hu").c_str(), sizeof R.headU);
  R.nCells = 0;
  for (int i = 1; i <= 4; i++) {
    char kk[4], kv[4], ku[4]; snprintf(kk, 4, "k%d", i); snprintf(kv, 4, "v%d", i); snprintf(ku, 4, "u%d", i);
    if (!p.has(kk)) continue;
    scr::Cell& c = R.cells[R.nCells++];
    strlcpy(c.k, p.get(kk).c_str(), sizeof c.k); strlcpy(c.v, p.get(kv).c_str(), sizeof c.v); strlcpy(c.u, p.get(ku).c_str(), sizeof c.u);
  }
  strlcpy(R.footL, p.get("fl").c_str(), sizeof R.footL); strlcpy(R.footR, p.get("fr").c_str(), sizeof R.footR);
  R.vault = stopCm == 0;
  showArm = run; showAt = millis();
  xSemaphoreGive(uiLock);
  return "{\"ok\":true}";
}
// /data: [n, limitCm] then n × [time µs (4), distance cm (2), signal (2)]
template <typename Send> void streamData(Send send) {
  recording = false;
  delay(5);
  uint32_t n = nSamples;
  uint32_t hdr[2] = {n, (uint32_t)limitCm};
  send((const char*)hdr, sizeof(hdr));
  static uint8_t chunk[8192];
  uint32_t i = 0;
  while (i < n) {
    size_t len = 0;
    while (i < n && len + 8 <= sizeof(chunk)) { memcpy(chunk + len, &sBuf[i], 8); len += 8; i++; }
    send((const char*)chunk, len);
  }
}

// ---- the sensor's key and certificate ----
// The private key is made on the sensor the first time it starts and never leaves it. The phone carries
// the certificate request (public) to GitHub once; a GitHub job gets the certificate from Let's Encrypt
// and renews it; the app brings each new certificate back here. A certificate is only accepted if it
// belongs to this sensor's key.
bool parseKey(mbedtls_pk_context* pk) {
  return mbedtls_pk_parse_key(pk, (const unsigned char*)keyPem.c_str(), keyPem.length() + 1, nullptr, 0, mbedtls_ctr_drbg_random, &drbg) == 0;
}
bool loadOrMakeKey() {
  keyPem = prefs.getString("key", "");
  if (keyPem.length()) return true;
  mbedtls_pk_context pk; mbedtls_pk_init(&pk);
  int r = mbedtls_pk_setup(&pk, mbedtls_pk_info_from_type(MBEDTLS_PK_ECKEY));
  if (!r) r = mbedtls_ecp_gen_key(MBEDTLS_ECP_DP_SECP256R1, mbedtls_pk_ec(pk), mbedtls_ctr_drbg_random, &drbg);
  static unsigned char buf[600];
  if (!r) r = mbedtls_pk_write_key_pem(&pk, buf, sizeof(buf));
  mbedtls_pk_free(&pk);
  if (r) return false;
  keyPem = String((const char*)buf);
  prefs.putString("key", keyPem);
  return true;
}
String makeCsr() {
  mbedtls_pk_context pk; mbedtls_pk_init(&pk);
  if (!parseKey(&pk)) { mbedtls_pk_free(&pk); return ""; }
  mbedtls_x509write_csr csr; mbedtls_x509write_csr_init(&csr);
  mbedtls_x509write_csr_set_md_alg(&csr, MBEDTLS_MD_SHA256);
  mbedtls_x509write_csr_set_key(&csr, &pk);
  String subj = String("CN=") + HOST;
  mbedtls_x509write_csr_set_subject_name(&csr, subj.c_str());
  // subjectAltName = DNS:HOST  (SEQUENCE { [2] IA5String })
  uint8_t san[80]; size_t hl = strlen(HOST);
  san[0] = 0x30; san[1] = (uint8_t)(hl + 2); san[2] = 0x82; san[3] = (uint8_t)hl; memcpy(san + 4, HOST, hl);
  mbedtls_x509write_csr_set_extension(&csr, MBEDTLS_OID_SUBJECT_ALT_NAME, MBEDTLS_OID_SIZE(MBEDTLS_OID_SUBJECT_ALT_NAME), 0, san, hl + 4);
  static unsigned char buf[1200];
  int r = mbedtls_x509write_csr_pem(&csr, buf, sizeof(buf), mbedtls_ctr_drbg_random, &drbg);
  mbedtls_x509write_csr_free(&csr); mbedtls_pk_free(&pk);
  return r ? String("") : String((const char*)buf);
}
// checks a certificate chain (PEM): parses, belongs to our key; fills its expiry
bool checkCert(const String& pem, char* until) {
  mbedtls_x509_crt crt; mbedtls_x509_crt_init(&crt);
  mbedtls_pk_context pk; mbedtls_pk_init(&pk);
  bool ok = mbedtls_x509_crt_parse(&crt, (const unsigned char*)pem.c_str(), pem.length() + 1) == 0 && parseKey(&pk)
         && mbedtls_pk_check_pair(&crt.pk, &pk, mbedtls_ctr_drbg_random, &drbg) == 0;
  if (ok && until) snprintf(until, 24, "%04d-%02d-%02dT%02d:%02d:%02dZ", crt.valid_to.year, crt.valid_to.mon, crt.valid_to.day, crt.valid_to.hour, crt.valid_to.min, crt.valid_to.sec);
  mbedtls_x509_crt_free(&crt); mbedtls_pk_free(&pk);
  return ok;
}
// a new certificate from the app: saved only if it's for this sensor
const char* installCert(const String& pem) {
  if (pem.length() < 200 || pem.length() > 8000) return "not a certificate";
  char until[24];
  if (!checkCert(pem, until)) return "that certificate isn't for this sensor";
  if (strcmp(until, certUntil) < 0) return "older than the one installed";
  prefs.putBytes("crt", pem.c_str(), pem.length() + 1);
  crtPem = pem; strcpy(certUntil, until);
  restartHttpsAt = millis() + 500;   // after this reply has gone out
  return nullptr;
}
size_t buildTls(char* json, size_t cap) {
  return snprintf(json, cap, "{\"host\":\"%s\",\"secure\":%s,\"until\":%s%s%s,\"running\":%s,\"heap\":%lu,\"biggest\":%lu,\"lowest\":%lu,\"psram\":%lu,\"fw\":\"%s\"}", HOST, certUntil[0] ? "true" : "false",
                  certUntil[0] ? "\"" : "", certUntil[0] ? certUntil : "null", certUntil[0] ? "\"" : "", https ? "true" : "false", (unsigned long)ESP.getFreeHeap(),
                  (unsigned long)ESP.getMaxAllocHeap(), (unsigned long)ESP.getMinFreeHeap(), (unsigned long)ESP.getFreePsram(), FW_VERSION);
}

// ---- firmware update over Wi-Fi: POST /update with the .bin as the body ----
bool updBegin(size_t total) {
  if (Update.isRunning()) Update.abort();
  updating = true; updatePct = 0;
  recording = false; state = ST_IDLE;
  if (!Update.begin(total ? total : UPDATE_SIZE_UNKNOWN)) { updating = false; return false; }
  return true;
}
bool updWrite(uint8_t* p, size_t n, size_t done, size_t total) {
  if (Update.write(p, n) != n) return false;
  if (total) updatePct = (int)(100.0 * done / total);
  return true;
}
String updEnd(bool ok) {
  if (ok && Update.end(true)) { updatePct = 100; rebootAt = millis() + 1500; return "{\"ok\":true}"; }
  String e = Update.errorString(); Update.abort(); updating = false;
  return String("{\"ok\":false,\"error\":\"") + e + "\"}";
}

// ---- https handlers ----
static const Asset A_PAGE  = {"text/html; charset=utf-8", PAGE_GZ, PAGE_GZ_LEN, "no-cache", true};
static const Asset A_SW    = {"application/javascript", ASSET_SW, ASSET_SW_LEN, "no-cache", false};
static const Asset A_MAN   = {"application/manifest+json", ASSET_MANIFEST, ASSET_MANIFEST_LEN, "max-age=86400", false};
static const Asset A_TOUCH = {"image/png", ASSET_APPLE_TOUCH_ICON, ASSET_APPLE_TOUCH_ICON_LEN, "max-age=86400", false};
static const Asset A_I192  = {"image/png", ASSET_ICON_192, ASSET_ICON_192_LEN, "max-age=86400", false};
static const Asset A_I512  = {"image/png", ASSET_ICON_512, ASSET_ICON_512_LEN, "max-age=86400", false};
static const Asset A_IMASK = {"image/png", ASSET_ICON_MASKABLE_512, ASSET_ICON_MASKABLE_512_LEN, "max-age=86400", false};
static const Asset A_FAV   = {"image/png", ASSET_FAVICON_32, ASSET_FAVICON_32_LEN, "max-age=86400", false};

// query string + (for a form POST) the body
static Params hsParams(httpd_req_t* r) {
  Params p;
  size_t ql = httpd_req_get_url_query_len(r);
  if (ql) { char* q = (char*)malloc(ql + 1); if (q && httpd_req_get_url_query_str(r, q, ql + 1) == ESP_OK) p.raw = q; free(q); }
  if (r->method == HTTP_POST && r->content_len > 0 && r->content_len < 4096) {
    String body; body.reserve(r->content_len + 1);
    char buf[512]; int left = r->content_len;
    while (left > 0) { int got = httpd_req_recv(r, buf, left < (int)sizeof(buf) ? left : sizeof(buf)); if (got <= 0) break; body.concat(buf, got); left -= got; }
    if (p.raw.length()) p.raw += "&";
    p.raw += body;
  }
  return p;
}
static esp_err_t hsJson(httpd_req_t* r, const String& s) {
  httpd_resp_set_type(r, "application/json"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  return httpd_resp_send(r, s.c_str(), s.length());
}
static esp_err_t hsAsset(httpd_req_t* r) {
  const Asset* a = (const Asset*)r->user_ctx;
  httpd_resp_set_type(r, a->type);
  httpd_resp_set_hdr(r, "Cache-Control", a->cache);
  if (a->gz) httpd_resp_set_hdr(r, "Content-Encoding", "gzip");
  return httpd_resp_send(r, (const char*)a->data, a->len);
}
static esp_err_t hsLive(httpd_req_t* r) {
  static char json[4600];
  Params p = hsParams(r);
  size_t n = buildLive(json, sizeof(json), p.has("from") ? p.num("from", -1) : -1);
  httpd_resp_set_type(r, "application/json"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  return httpd_resp_send(r, json, n);
}
static esp_err_t hsArm(httpd_req_t* r) { return hsJson(r, apiArm(hsParams(r))); }
static esp_err_t hsShow(httpd_req_t* r) { return hsJson(r, apiShow(hsParams(r))); }
static esp_err_t hsStop(httpd_req_t* r) { doStop(); return httpd_resp_sendstr(r, "stopped"); }
static esp_err_t hsData(httpd_req_t* r) {
  httpd_resp_set_type(r, "application/octet-stream"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  streamData([r](const char* p, size_t n) { httpd_resp_send_chunk(r, p, n); });
  return httpd_resp_send_chunk(r, nullptr, 0);
}
static esp_err_t hsTls(httpd_req_t* r) {
  char json[360]; size_t n = buildTls(json, sizeof(json));
  httpd_resp_set_type(r, "application/json"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  return httpd_resp_send(r, json, n);
}
static esp_err_t hsCertPost(httpd_req_t* r) {
  if (r->content_len > 8000) return httpd_resp_send_err(r, HTTPD_400_BAD_REQUEST, "too big");
  String body; body.reserve(r->content_len + 1);
  char buf[512]; int left = r->content_len;
  while (left > 0) { int got = httpd_req_recv(r, buf, left < (int)sizeof(buf) ? left : sizeof(buf)); if (got <= 0) return ESP_FAIL; body.concat(buf, got); left -= got; }
  const char* err = installCert(body);
  if (err) return hsJson(r, String("{\"ok\":false,\"error\":\"") + err + "\"}");
  return hsJson(r, "{\"ok\":true}");
}
static esp_err_t hsUpdate(httpd_req_t* r) {
  size_t total = r->content_len, done = 0;
  if (!total || !updBegin(total)) return hsJson(r, "{\"ok\":false,\"error\":\"couldn't start the update\"}");
  static uint8_t buf[4096]; bool ok = true;
  while (done < total) {
    int got = httpd_req_recv(r, (char*)buf, total - done < sizeof(buf) ? total - done : sizeof(buf));
    if (got == HTTPD_SOCK_ERR_TIMEOUT) continue;
    if (got <= 0) { ok = false; break; }
    done += got;
    if (!updWrite(buf, got, done, total)) { ok = false; break; }
  }
  return hsJson(r, updEnd(ok && done == total));
}
void startHttps() {
  if (https) { httpd_ssl_stop(https); https = nullptr; }
  if (!certUntil[0]) return;
  httpd_ssl_config_t c = HTTPD_SSL_CONFIG_DEFAULT();
  c.servercert = (const uint8_t*)crtPem.c_str(); c.servercert_len = crtPem.length() + 1;
  c.prvtkey_pem = (const uint8_t*)keyPem.c_str(); c.prvtkey_len = keyPem.length() + 1;
  // Several phones at once: each secure connection's buffers (~40 KB) go to PSRAM, so there's room for
  // a couple of connections per device. Old idle ones are closed first when it's full.
  c.httpd.max_open_sockets = 8;
  c.httpd.lru_purge_enable = true;
  c.httpd.max_uri_handlers = 24;
  c.httpd.stack_size = 12288;
  c.httpd.recv_wait_timeout = 10;
  c.httpd.send_wait_timeout = 10;
  if (httpd_ssl_start(&https, &c) != ESP_OK) { https = nullptr; Serial.println("https didn't start"); return; }
  auto on = [](const char* uri, httpd_method_t m, esp_err_t (*h)(httpd_req_t*), const void* ctx) {
    httpd_uri_t u = {}; u.uri = uri; u.method = m; u.handler = h; u.user_ctx = (void*)ctx; httpd_register_uri_handler(https, &u);
  };
  on("/", HTTP_GET, hsAsset, &A_PAGE);
  on("/index.html", HTTP_GET, hsAsset, &A_PAGE);
  on("/sw.js", HTTP_GET, hsAsset, &A_SW);
  on("/manifest.webmanifest", HTTP_GET, hsAsset, &A_MAN);
  on("/icons/apple-touch-icon.png", HTTP_GET, hsAsset, &A_TOUCH);
  on("/apple-touch-icon.png", HTTP_GET, hsAsset, &A_TOUCH);
  on("/icons/icon-192.png", HTTP_GET, hsAsset, &A_I192);
  on("/icons/icon-512.png", HTTP_GET, hsAsset, &A_I512);
  on("/icons/icon-maskable-512.png", HTTP_GET, hsAsset, &A_IMASK);
  on("/icons/favicon-32.png", HTTP_GET, hsAsset, &A_FAV);
  on("/live", HTTP_GET, hsLive, nullptr);
  on("/arm", HTTP_GET, hsArm, nullptr);
  on("/arm", HTTP_POST, hsArm, nullptr);
  on("/show", HTTP_POST, hsShow, nullptr);
  on("/stop", HTTP_GET, hsStop, nullptr);
  on("/data", HTTP_GET, hsData, nullptr);
  on("/tls", HTTP_GET, hsTls, nullptr);
  on("/cert", HTTP_POST, hsCertPost, nullptr);
  on("/update", HTTP_POST, hsUpdate, nullptr);
  Serial.printf("Secure: https://%s (certificate until %s)\n", HOST, certUntil);
}

// ---- http (setup and fallback) ----
void sendAsset(const Asset& a) {
  server.sendHeader("Cache-Control", a.cache);
  if (a.gz) server.sendHeader("Content-Encoding", "gzip");
  server.send_P(200, a.type, (const char*)a.data, a.len);
}
void handleRoot() {
  // once the secure address works, send the phone there (?here=1 keeps the plain copy, e.g. for setup)
  if (certUntil[0] && https && !server.hasArg("here")) { server.sendHeader("Location", String("https://") + HOST + "/"); server.send(302, "text/plain", ""); return; }
  sendAsset(A_PAGE);
}
void handleData() {
  server.sendHeader("Cache-Control", "no-store");
  server.setContentLength(8 + (size_t)nSamples * 8);
  server.send(200, "application/octet-stream", "");
  streamData([](const char* p, size_t n) { server.sendContent(p, n); });
}
static Params wsParams() { Params p; p.ws = &server; return p; }
static void wsJson(const String& s) { server.sendHeader("Cache-Control", "no-store"); server.send(200, "application/json", s); }

void setup() {
  Serial.begin(115200);
  uiLock = xSemaphoreCreateMutex();

  // The run buffer and the screen's frame live in PSRAM (8 MB on the N16R8).
  if (!psramFound()) { Serial.println("No PSRAM: Tools > PSRAM > \"OPI PSRAM\""); }
  sBuf = (Sample*)ps_malloc(MAX_SAMPLES * sizeof(Sample));
  scr::fb = (uint16_t*)ps_malloc(scr::W * scr::H * 2);
  if (!sBuf || !scr::fb) {
    Serial.println("Not enough memory: is PSRAM turned on? (Tools > PSRAM > OPI PSRAM)");
    while (true) delay(1000);
  }
  tftInit();
  xTaskCreatePinnedToCore(screenTask, "screen", 8192, nullptr, 1, nullptr, 0);

  Serial1.setRxBufferSize(8192);
  Serial1.begin(115200, SERIAL_8N1, PIN_LIDAR_RX, PIN_LIDAR_TX);
  delay(500);
  configureLidar();

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS, 1, 0, MAX_DEVICES);
  WiFi.setSleep(false);
  delay(100);
  // answer the sensor's own name on this Wi-Fi, so the secure address works with no internet
  dns.setErrorReplyCode(DNSReplyCode::NonExistentDomain);
  dns.start(53, HOST, WiFi.softAPIP());

  // key + certificate
  mbedtls_entropy_init(&entropy); mbedtls_ctr_drbg_init(&drbg);
  mbedtls_ctr_drbg_seed(&drbg, mbedtls_entropy_func, &entropy, (const unsigned char*)"speedlidar", 10);
  prefs.begin("tls", false);
  if (!loadOrMakeKey()) Serial.println("Couldn't make the sensor's key");
  size_t cl = prefs.getBytesLength("crt");
  if (cl > 0 && cl <= 8001) {
    char* b = (char*)malloc(cl); prefs.getBytes("crt", b, cl); crtPem = String(b); free(b);
    if (!checkCert(crtPem, certUntil)) { certUntil[0] = 0; crtPem = ""; }
  }
  startHttps();
  Serial.printf("Open http://%s  (free memory %lu, PSRAM %lu)\n", WiFi.softAPIP().toString().c_str(), (unsigned long)ESP.getFreeHeap(), (unsigned long)ESP.getFreePsram());

  server.on("/", handleRoot);
  server.on("/index.html", handleRoot);
  server.on("/live", [] { static char json[4600]; buildLive(json, sizeof(json), server.hasArg("from") ? server.arg("from").toInt() : -1);
                          server.sendHeader("Cache-Control", "no-store"); server.send(200, "application/json", json); });
  server.on("/arm", [] { wsJson(apiArm(wsParams())); });
  server.on("/show", HTTP_POST, [] { wsJson(apiShow(wsParams())); });
  server.on("/stop", [] { doStop(); server.send(200, "text/plain", "stopped"); });
  server.on("/data", handleData);
  server.on("/tls", [] { char json[360]; buildTls(json, sizeof(json)); server.sendHeader("Cache-Control", "no-store"); server.send(200, "application/json", json); });
  server.on("/csr", [] { server.sendHeader("Cache-Control", "no-store"); server.send(200, "text/plain", makeCsr()); });
  server.on("/cert", HTTP_POST, [] {
    const char* err = installCert(server.arg("plain"));
    server.send(200, "application/json", err ? String("{\"ok\":false,\"error\":\"") + err + "\"}" : String("{\"ok\":true}"));
  });
  // firmware update: the .bin as the raw body (application/octet-stream)
  server.on("/update", HTTP_POST, [] {}, [] {
    static bool ok = true; static size_t done = 0, total = 0;
    HTTPRaw& raw = server.raw();
    if (raw.status == RAW_START) { total = server.header("Content-Length").toInt(); done = 0; ok = updBegin(total); }
    else if (raw.status == RAW_WRITE && ok) { done += raw.currentSize; ok = updWrite(raw.buf, raw.currentSize, done, total); }
    else if (raw.status == RAW_END) wsJson(updEnd(ok));
    else if (raw.status == RAW_ABORTED) { Update.abort(); updating = false; }
  });
  server.on("/sw.js", [] { sendAsset(A_SW); });
  server.on("/manifest.webmanifest", [] { sendAsset(A_MAN); });
  server.on("/icons/apple-touch-icon.png", [] { sendAsset(A_TOUCH); });
  server.on("/apple-touch-icon.png", [] { sendAsset(A_TOUCH); });
  server.on("/icons/icon-192.png", [] { sendAsset(A_I192); });
  server.on("/icons/icon-512.png", [] { sendAsset(A_I512); });
  server.on("/icons/icon-maskable-512.png", [] { sendAsset(A_IMASK); });
  server.on("/icons/favicon-32.png", [] { sendAsset(A_FAV); });
  server.on("/favicon.ico", [] { sendAsset(A_FAV); });
  const char* hdrs[] = {"Content-Length"}; server.collectHeaders(hdrs, 1);
  server.begin();

  // Arduino IDE uploads over Wi-Fi (network port "speedlidar")
  ArduinoOTA.setHostname("speedlidar");
  ArduinoOTA.setPassword(AP_PASS);
  ArduinoOTA.onStart([] { updating = true; updatePct = 0; recording = false; state = ST_IDLE; });
  ArduinoOTA.onProgress([](unsigned int a, unsigned int b) { updatePct = b ? (int)(100.0 * a / b) : 0; });
  ArduinoOTA.onError([](ota_error_t) { updating = false; });
  ArduinoOTA.begin();

  xTaskCreatePinnedToCore(lidarTask, "lidar", 4096, nullptr, 3, nullptr, 1);
}

void loop() {
  dns.processNextRequest();
  server.handleClient();
  ArduinoOTA.handle();
  if (restartHttpsAt && (int32_t)(millis() - restartHttpsAt) >= 0) { restartHttpsAt = 0; startHttps(); }
  if (rebootAt && (int32_t)(millis() - rebootAt) >= 0) ESP.restart();
  delay(1);
}
