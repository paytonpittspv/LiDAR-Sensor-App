namespace pagem {
  volatile uint32_t until = 0; volatile bool live = false;   // live: Home / New session, where the live distance is the better screen
  char title[24] = "", k[24] = "", v[14] = "", u[8] = "", sub[44] = ""; scr::Cell c[3]; int n = 0;
}
volatile float    levelAtM = 30.48f;  // how far down the runway to work out the beam height (m)

void screenTask(void*) {
  static scr::Model M;
  M.ssid = AP_SSID; M.pass = AP_PASS; M.host = HOST;
  static char fw[32]; snprintf(fw, sizeof fw, "%s \xC2\xB7 S3 \xC2\xB7 %s", FW_VERSION, "secure"); M.fw = fw;
  uint32_t boot = millis(), since = millis(), phonesAt = 0, runStartCm = 0;
  scr::Screen last = scr::S_BOOT; float vSmooth = 0; bool lidarSeen = false;
  uint32_t partialSince = 0, lockedUntil = 0;
  digitalWrite(PIN_TFT_BL, HIGH);
  for (;;) {
    uint32_t now = millis();
    if (now - phonesAt > 500) { M.phones = phoneCount(); phonesAt = now; }
    M.sig = liveSig;
    M.imuOk = imu::ok; M.zeroed = imu::zeroed; M.pitch = imu::pitchS; M.roll = imu::rollS; M.levelAt = levelAtM;
    M.bumped = imu::bumped; M.bumpDeg = imu::bumpDeg; strlcpy(M.bumpWhy, imu::bumpWhy, sizeof M.bumpWhy);
    uint16_t d = liveDist;
    M.distOk = validCm(d); M.dist = d / 100.f;
    M.inZone = M.distOk && (gateCm == 0 || d < gateCm); M.hold = holdFrac;
    if (liveRate > 0) lidarSeen = true;
    M.lidar = (lidarSeen && liveRate > 0) || now - boot < 4000;
    uint8_t st = state;
    xSemaphoreTake(uiLock, portMAX_DELAY);
    M.armedCfg = armId > 0 && st != ST_IDLE;
    strlcpy(M.who, armWho, sizeof M.who); strlcpy(M.evShort, armEvS, sizeof M.evShort); strlcpy(M.evLine, armEvL, sizeof M.evLine);
    M.vault = stopCm == 0;
    float target = armTarget;
    bool haveResult = showArm == armId && showArm;
    if (haveResult) {
      memcpy(M.strip, resultModel.strip, sizeof M.strip); memcpy(M.head, resultModel.head, sizeof M.head);
      memcpy(M.headV, resultModel.headV, sizeof M.headV); memcpy(M.headU, resultModel.headU, sizeof M.headU);
      memcpy(M.cells, resultModel.cells, sizeof M.cells); M.nCells = resultModel.nCells;
      memcpy(M.footL, resultModel.footL, sizeof M.footL); memcpy(M.footR, resultModel.footR, sizeof M.footR);
    }
    // a result stays up after the next run is set up, until someone stands in to arm (or 3 minutes pass)
    bool holdResult = showArm && showAt && now - showAt < 180000 && !(M.inZone && M.hold > .15f);
    xSemaphoreGive(uiLock);

    scr::Screen s;
    if (updating) { s = scr::S_UPDATE; M.updatePct = updatePct; }
    else if ((int32_t)(aboutUntil - now) > 0 && st != ST_SET && st != ST_RUN) { s = scr::S_ABOUT; M.upS = now / 1000; M.reset = resetWhy; M.boots = bootCount; }
    else if (now - boot < 2200) s = scr::S_BOOT;
    else if ((int32_t)(levelUntil - now) > 0 && st != ST_SET && st != ST_RUN) s = scr::S_LEVEL;
    else if ((int32_t)(jumpm::until - now) > 0 && st != ST_SET && st != ST_RUN) {
      s = scr::S_JUMP;
      xSemaphoreTake(uiLock, portMAX_DELAY);
      strlcpy(M.jWho, jumpm::who, sizeof M.jWho); strlcpy(M.jPod, jumpm::pod, sizeof M.jPod); strlcpy(M.jBest, jumpm::best, sizeof M.jBest); strlcpy(M.jNext, jumpm::next, sizeof M.jNext);
      M.jRes = jumpm::res; strlcpy(M.jH, jumpm::h, sizeof M.jH); strlcpy(M.jHs, jumpm::hs, sizeof M.jHs); strlcpy(M.jHm, jumpm::hm, sizeof M.jHm); strlcpy(M.jRWho, jumpm::rwho, sizeof M.jRWho);
      xSemaphoreGive(uiLock);
      if (jumpm::simPh >= 0 && (int32_t)(jumpm::simUntil - now) > 0) { M.jPh = jumpm::simPh; M.jV = jumpm::simV; M.jAirMs = M.jPh == 2 ? now - jumpm::simAirAt : 0; }
      else { uint32_t airAt = 0; M.jPh = podPhase(M.jV, airAt); M.jAirMs = airAt ? now - airAt : 0; }
    }
    else if (!lidarSeen && now - boot < 4000) s = scr::S_BOOT;
    else if (st == ST_SET) s = scr::S_ARMED;
    else if (st == ST_RUN) s = scr::S_REC;
    else if (st == ST_DONE) s = haveResult ? scr::S_RESULT : scr::S_SAVING;
    else if (holdResult && (st == ST_WAIT || st == ST_IDLE)) {
      s = scr::S_RESULT;
      if (!haveResult) {   // the result belongs to the previous run: show the copy we kept
        xSemaphoreTake(uiLock, portMAX_DELAY);
        memcpy(M.strip, resultModel.strip, sizeof M.strip); memcpy(M.head, resultModel.head, sizeof M.head);
        memcpy(M.headV, resultModel.headV, sizeof M.headV); memcpy(M.headU, resultModel.headU, sizeof M.headU);
        memcpy(M.cells, resultModel.cells, sizeof M.cells); M.nCells = resultModel.nCells;
        memcpy(M.footL, resultModel.footL, sizeof M.footL); memcpy(M.footR, resultModel.footR, sizeof M.footR);
        M.vault = resultModel.vault;
        xSemaphoreGive(uiLock);
      }
    }
    else if (M.phones == 0 && st == ST_IDLE) s = scr::S_WIFI;
    // nothing being run: follow the app's page. With the LiDAR working, Home and New session keep the live distance.
    else if (st == ST_IDLE && (int32_t)(pagem::until - now) > 0 && (!M.lidar || !pagem::live)) {
      s = scr::S_PAGE;
      xSemaphoreTake(uiLock, portMAX_DELAY);
      strlcpy(M.pgTitle, pagem::title, sizeof M.pgTitle); strlcpy(M.pgK, pagem::k, sizeof M.pgK); strlcpy(M.pgV, pagem::v, sizeof M.pgV);
      strlcpy(M.pgU, pagem::u, sizeof M.pgU); strlcpy(M.pgSub, pagem::sub, sizeof M.pgSub); memcpy(M.pg, pagem::c, sizeof M.pg); M.nPg = pagem::n;
      xSemaphoreGive(uiLock);
    }
    else s = scr::S_READY;
    // Aiming: the beam only partly hits someone at the start (the tripod is being lined up). Shown once that
    // lasts most of a second (not when someone just walks through), then "locked on" for a moment.
    bool partial = M.sig >= 10 && M.sig < 95;
    if (partial) { if (!partialSince) partialSince = now; } else partialSince = 0;
    if (s == scr::S_READY && !(M.hold > .15f)) {
      if (partialSince && now - partialSince > 800) s = scr::S_AIM;
      else if (last == scr::S_AIM && M.sig >= 95) { lockedUntil = now + 1500; s = scr::S_AIM; if (imu::ok) imu::cmd = imu::C_LOCK; }   // aimed: remember where it points
      else if (now < lockedUntil) s = scr::S_AIM;
    }

    if (s == scr::S_REC) {
      uint32_t n = nSamples, g = goIdx;
      if (last != scr::S_REC) {
        // where they started: closest reading in the 1.5 s before the run was confirmed
        uint16_t start = 0xFFFF; for (uint32_t i = g > 1500 ? g - 1500 : 0; i < g && i < n; i++) if (validCm(sBuf[i].d) && sBuf[i].d < start) start = sBuf[i].d;
        runStartCm = start == 0xFFFF ? d : start; vSmooth = 0;
      }
      float v = liveSpeed(n); vSmooth = vSmooth ? .6f * vSmooth + .4f * v : v;
      M.speed = vSmooth;
      M.runDist = M.distOk && d > runStartCm ? (d - runStartCm) / 100.f : M.runDist;
      M.runTarget = M.vault ? (limitCm > runStartCm ? (limitCm - runStartCm) / 100.f : 0) : target;
      M.runTime = n && g && g <= n ? (sBuf[n - 1].t - sBuf[g - 1].t) / 1e6f : 0;
    }
    if (s != last) { last = s; since = now; }
    M.screen = s; M.t = now - since;
    xSemaphoreTake(uiLock, portMAX_DELAY); shown = M; xSemaphoreGive(uiLock);
    scr::draw(M);
    tftPush();
    vTaskDelay(pdMS_TO_TICKS(40));
  }
}

