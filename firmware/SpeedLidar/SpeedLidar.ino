mbedtls_ctr_drbg_context drbg;


static void jsonEscape(String& out, const String& s) {
  for (size_t i = 0; i < s.length(); i++) {
    char c = s[i];
    if (c == '"' || c == '\\') { out += '\\'; out += c; }
    else if ((uint8_t)c < 0x20) { char b[8]; snprintf(b, sizeof b, "\\u%04x", c); out += b; }
    else out += c;
  }
}

// ---- controller or display ----
const char* roleFor(const String& dev) {
  if (!dev.length()) return "control";            // an older app: treat as the controller
  xSemaphoreTake(uiLock, portMAX_DELAY);
  if (!ctlDev[0]) strlcpy(ctlDev, dev.c_str(), sizeof ctlDev);
  bool ctl = dev == ctlDev;
  xSemaphoreGive(uiLock);
  return ctl ? "control" : "display";
}
String apiClaim(const Params& p) {
  String dev = p.get("dev"); if (!dev.length()) return "{\"ok\":false}";
  xSemaphoreTake(uiLock, portMAX_DELAY); strlcpy(ctlDev, dev.c_str(), sizeof ctlDev); xSemaphoreGive(uiLock);
  return "{\"ok\":true,\"role\":\"control\"}";
}
// /pick?name=...: the display picked who's up next
String apiPick(const Params& p) {
  String n = p.get("name"); n.trim();
  if (!n.length()) return "{\"ok\":false}";
  xSemaphoreTake(uiLock, portMAX_DELAY);
  strlcpy(pickName, n.c_str(), sizeof pickName);
  strlcpy(armWho, n.c_str(), sizeof armWho);   // both screens show it straight away
  uint32_t id = ++pickId;
  xSemaphoreGive(uiLock);
  return String("{\"ok\":true,\"pick\":") + id + "}";
}
// /order (POST roster=names, lineup=n): the display dragged the roster into a new order
String apiOrder(const Params& p) {
  String r = p.get("roster"); if (!r.length() || r.length() > 1500) return "{\"ok\":false}";
  xSemaphoreTake(uiLock, portMAX_DELAY);
  armRoster = r; armLineup = p.num("lineup", 0); uint32_t id = ++orderId;
  xSemaphoreGive(uiLock);
  return String("{\"ok\":true,\"order\":") + id + "}";
}
// /screen: what the sensor's screen shows, for a display device (iPad on the tripod)
String apiScreen() {
  xSemaphoreTake(uiLock, portMAX_DELAY);
  scr::Model M = shown; uint32_t aId = armId, sId = showArm; String nextWho = armWho, roster = armRoster; uint32_t pk = pickId, od = orderId; int lu = armLineup;
  xSemaphoreGive(uiLock);
  auto q = [](String& o, const char* k, const char* v) { o += ",\""; o += k; o += "\":\""; jsonEscape(o, String(v)); o += "\""; };
  String o; o.reserve(900);
  o += "{\"s\":\""; o += scr::SCREEN_NAMES[M.screen]; o += "\"";
  char b[220];
  snprintf(b, sizeof b, ",\"t\":%lu,\"phones\":%d,\"sig\":%d,\"vault\":%s,\"armed\":%s,\"dist\":%s,\"hold\":%.2f,\"inZone\":%s,\"speed\":%.2f,\"runDist\":%.2f,\"runTarget\":%.2f,\"runTime\":%.1f,\"pct\":%d",
           (unsigned long)M.t, M.phones, M.sig, M.vault ? "true" : "false", M.armedCfg ? "true" : "false", M.distOk ? String(M.dist, 2).c_str() : "null",
           M.hold, M.inZone ? "true" : "false", M.speed, M.runDist, M.runTarget, M.runTime, M.updatePct);
  o += b;
  q(o, "evs", M.evShort); q(o, "evl", M.evLine); q(o, "who", M.who);
  if (M.screen == scr::S_LEVEL) {  // the level: nose and lean (degrees), where the beam is judged, zeroed or not
    char lb[120]; snprintf(lb, sizeof lb, ",\"lvOk\":%s,\"lvP\":%.2f,\"lvR\":%.2f,\"lvAt\":%.2f,\"lvZ\":%s", M.imuOk ? "true" : "false", M.pitch, M.roll, M.levelAt, M.zeroed ? "true" : "false"); o += lb;
  }
  if (M.screen == scr::S_JUMP) {   // the jump test: live phase, takeoff speed, ms since takeoff; who; the result
    char jb[80]; snprintf(jb, sizeof jb, ",\"jPh\":%d,\"jV\":%.2f,\"jAir\":%lu,\"jRes\":%s", M.jPh, M.jV, (unsigned long)M.jAirMs, M.jRes ? "true" : "false"); o += jb;
    q(o, "jWho", M.jWho); q(o, "jPod", M.jPod); q(o, "jBest", M.jBest); q(o, "jNext", M.jNext);
    q(o, "jH", M.jH); q(o, "jHs", M.jHs); q(o, "jHm", M.jHm); q(o, "jRw", M.jRWho);
  }
  q(o, "strip", M.strip); q(o, "head", M.head); q(o, "hv", M.headV); q(o, "hu", M.headU); q(o, "fl", M.footL); q(o, "fr", M.footR);
  // after a result, the next run may already be set up: who's up next
  q(o, "next", sId && aId != sId ? nextWho.c_str() : "");
  o += ",\"pick\":"; o += pk; o += ",\"order\":"; o += od; o += ",\"lineup\":"; o += lu;
  o += ",\"roster\":[";
  { int from = 0, k = 0;
    while (from < (int)roster.length()) {
      int nl = roster.indexOf('\n', from); if (nl < 0) nl = roster.length();
      String nm = roster.substring(from, nl); nm.trim(); from = nl + 1;
      if (!nm.length()) continue;
      if (k++) o += ","; o += "\""; jsonEscape(o, nm); o += "\"";
    } }
  o += "]";
  o += ",\"cells\":[";
  for (int i = 0; i < M.nCells; i++) {
    if (i) o += ",";
    o += "[\""; jsonEscape(o, M.cells[i].k); o += "\",\""; jsonEscape(o, M.cells[i].v); o += "\",\""; jsonEscape(o, M.cells[i].u); o += "\"]";
  }
  o += "]}";
  return o;
}


// ---------------- the waist pods ----------------
// Each pod (XIAO ESP32-S3 + BMI160) joins this Wi-Fi like a phone and says who it is (id: the end of its Wi-Fi
// address). It checks in every second (GET /pod/hello?id=, plain http, port 80) and gets back any command the app
// left for it; after each jump it sends its recording (POST /pod/push?id=). The app reads a pod's recording
// (/pod/data?id=), leaves commands (/pod/cmd id=) and can hand over new pod firmware (/pod/fw), which every pod then
// downloads from here (/pod/fw.bin). The pods' status goes out in /live ("pods"; "pod" is the first, for older apps).
namespace pod {
  struct Slot {
    char id[8] = "";
    uint32_t seenAt = 0, seq = 0, msgSeq = 0;
    char fw[20] = "", msg[32] = "";
    bool imu = false, cal = false, still = false;
    int sides = 0, rssi = 0, ph = 0, v = 0;
    String cmd = "";                 // the next command for this pod (JSON), sent with its next check-in
    uint8_t* buf = nullptr; size_t len = 0;   // its last recording (PSRAM)
    // clock: this sensor's micros() minus the pod's (mod 2^32). Each check-in carries the pod's micros() as it
    // left; the smallest difference is the one that spent the least time on the way, so keep the minimum (and let
    // it creep up slowly, so the two crystals' small drift is followed)
    uint32_t off = 0; bool offOk = false;
  };
  const int N = 4;
  Slot s[N];
  uint8_t* fwBuf = nullptr; volatile size_t fwLen = 0;       // pod firmware waiting to be picked up
  const size_t MAX_REC = 256 * 1024, MAX_FW = 2 * 1024 * 1024;
  bool online(const Slot& k) { return k.seenAt && millis() - k.seenAt < 4000; }
  String cleanId(String id) { id.trim(); if (!id.length()) id = "pod"; if (id.length() > 7) id = id.substring(0, 7); return id; }
  // the slot for this id; make=true takes a free one (or the one gone longest) for a new pod
  Slot* find(const String& raw, bool make) {
    String id = cleanId(raw);
    for (auto& k : s) if (!strcmp(k.id, id.c_str())) return &k;
    if (!make) return nullptr;
    Slot* best = nullptr;
    for (auto& k : s) if (!k.id[0]) { best = &k; break; }
    if (!best) for (auto& k : s) if (!online(k) && (!best || k.seenAt < best->seenAt)) best = &k;
    if (!best) return nullptr;
    uint8_t* keep = best->buf; *best = Slot(); best->buf = keep;
    strlcpy(best->id, id.c_str(), sizeof best->id);
    return best;
  }
  // the app didn't say which pod: the first one online
  Slot* pick(const String& raw) {
    if (raw.length()) return find(raw, false);
    for (auto& k : s) if (k.id[0] && online(k)) return &k;
    for (auto& k : s) if (k.id[0]) return &k;
    return nullptr;
  }
  int index(const Slot* k) { return k ? (int)(k - s) : -1; }
}
// GET /pod/hello?id=&fw=&imu=&cal=&sides=&rssi=&still=&ph=&v=&msg= (from a pod)
String apiPodHello(const Params& p) {
  xSemaphoreTake(uiLock, portMAX_DELAY);
  pod::Slot* k = pod::find(p.get("id"), true);
  if (!k) { xSemaphoreGive(uiLock); return "{}"; }
  k->seenAt = millis();
  strlcpy(k->fw, p.get("fw").c_str(), sizeof k->fw);
  k->imu = p.num("imu", 0); k->cal = p.num("cal", 0); k->sides = p.num("sides", 0); k->rssi = p.num("rssi", 0); k->still = p.num("still", 0); k->ph = p.num("ph", 0); k->v = p.num("v", 0);
  String m = p.get("msg"); if (m.length()) { strlcpy(k->msg, m.c_str(), sizeof k->msg); k->msgSeq++; }
  if (p.get("us").length()) {
    uint32_t cand = micros() - (uint32_t)strtoul(p.get("us").c_str(), nullptr, 10);
    if (!k->offOk) { k->off = cand; k->offOk = true; }
    else { int32_t d = (int32_t)(cand - k->off); if (d < 0 || d > 200000) k->off = cand; else k->off += d < 60 ? d : 60; }
  }
  String c = k->cmd; k->cmd = "";
  xSemaphoreGive(uiLock);
  return c.length() ? c : String("{}");
}
// POST /pod/cmd id=&do=cal&side=0..5 | send | uncal (from the app)
String apiPodCmd(const Params& p) {
  String d = p.get("do"), c;
  if (d == "cal") { long side = p.num("side", -1); if (side < 0 || side > 5) return "{\"ok\":false}"; c = String("{\"cmd\":\"cal\",\"side\":") + side + "}"; }
  else if (d == "send") c = "{\"cmd\":\"send\"}";
  else if (d == "uncal") c = "{\"cmd\":\"uncal\"}";
  else return "{\"ok\":false}";
  xSemaphoreTake(uiLock, portMAX_DELAY);
  pod::Slot* k = pod::pick(p.get("id"));
  bool on = k && pod::online(*k); if (k) k->cmd = c;
  xSemaphoreGive(uiLock);
  return String("{\"ok\":") + (k ? "true" : "false") + ",\"online\":" + (on ? "true" : "false") + "}";
}
// a received body, in pieces: start (total size), write, end. Into PSRAM, for a pod's recording or for pod firmware.
static bool podSinkBegin(PodSink& k, size_t total, bool firmware, const String& id) {
  k.got = 0; k.ok = false; k.slot = -1;
  size_t cap = firmware ? pod::MAX_FW : pod::MAX_REC;
  if (!total || total > cap) return false;
  uint8_t** b = &pod::fwBuf;
  if (!firmware) {
    xSemaphoreTake(uiLock, portMAX_DELAY); pod::Slot* s = pod::find(id, true); xSemaphoreGive(uiLock);
    if (!s) return false;
    k.slot = pod::index(s); b = &s->buf; s->len = 0;
  } else pod::fwLen = 0;
  if (!*b) *b = (uint8_t*)ps_malloc(cap);
  if (!*b) return false;
  k.dst = *b; k.cap = cap; k.ok = true;
  return true;
}
static void podSinkWrite(PodSink& k, const uint8_t* d, size_t n) { if (!k.ok) return; if (k.got + n > k.cap) { k.ok = false; return; } memcpy(k.dst + k.got, d, n); k.got += n; }
static String podSinkEnd(PodSink& k, bool firmware) {
  if (!k.ok) return "{\"ok\":false}";
  if (firmware) {
    // an ESP32 app image starts with 0xE9
    if (k.got < 1024 || k.dst[0] != 0xE9) return "{\"ok\":false,\"error\":\"not a firmware file\"}";
    pod::fwLen = k.got;
    // every pod picks it up with its next check-in
    int n = 0;
    xSemaphoreTake(uiLock, portMAX_DELAY); for (auto& s : pod::s) if (s.id[0]) { s.cmd = "{\"cmd\":\"update\"}"; n++; } xSemaphoreGive(uiLock);
    return String("{\"ok\":true,\"bytes\":") + k.got + ",\"pods\":" + n + "}";
  }
  if (k.got < 32 || memcmp(k.dst, "POD1", 4) || k.slot < 0) return "{\"ok\":false}";
  pod::Slot& s = pod::s[k.slot];
  s.len = k.got; s.seq++;
  return String("{\"ok\":true,\"seq\":") + s.seq + "}";
}
// a pod's status as JSON
namespace pod {   // (inside the namespace, so the Arduino builder doesn't put its prototype above the type)
void json(String& c, const Slot& k) {
  char pj[300];
  snprintf(pj, sizeof pj, "{\"id\":\"%s\",\"on\":%s,\"fw\":\"%s\",\"imu\":%s,\"cal\":%s,\"sides\":%d,\"rssi\":%d,\"still\":%s,\"ph\":%d,\"v\":%d,\"seq\":%lu,\"msg\":\"%s\",\"msgSeq\":%lu}",
           k.id, online(k) ? "true" : "false", k.fw, k.imu ? "true" : "false", k.cal ? "true" : "false", k.sides, k.rssi, k.still ? "true" : "false", k.ph, k.v,
           (unsigned long)k.seq, k.msg, (unsigned long)k.msgSeq);
  c += pj;
}
}
// the pod that's doing something (in the air beats landed beats set): its phase, takeoff speed and when it took off
int podPhase(float& v, uint32_t& airAt) {
  static uint8_t lastPh[pod::N] = {0}; static uint32_t air[pod::N] = {0};
  int best = 0; v = 0; airAt = 0;
  xSemaphoreTake(uiLock, portMAX_DELAY);
  for (int i = 0; i < pod::N; i++) {
    const pod::Slot& k = pod::s[i]; int ph = k.id[0] && pod::online(k) ? k.ph : 0;
    if (ph == 2 && lastPh[i] != 2) air[i] = millis() > 100 ? millis() - 100 : 0;   // ~80 ms into the flight, plus Wi-Fi
    lastPh[i] = ph;
    int rank = ph == 2 ? 3 : ph == 3 ? 2 : ph == 1 ? 1 : 0;
    int brank = best == 2 ? 3 : best == 3 ? 2 : best == 1 ? 1 : 0;
    if (rank > brank) { best = ph; v = k.v / 100.f; airAt = air[i]; }
  }
  xSemaphoreGive(uiLock);
  return best;
}
int phoneCount() { int n = WiFi.softAPgetStationNum(); for (auto& k : pod::s) if (k.id[0] && pod::online(k)) n--; return n < 0 ? 0 : n; }

// ---- the shared bits of each request ----
// /live: sensor status; with from=N also the run so far (up to 150 points, every 20th reading)
size_t buildLive(char* json, size_t cap, long from, const char* role) {
  uint16_t d = liveDist;
  int len = snprintf(json, cap,
           "{\"d\":%u,\"s\":%u,\"rate\":%lu,\"rec\":%s,\"moved\":%s,\"n\":%lu,\"bad\":%lu,\"max\":%u,\"state\":%u,\"sets\":%lu,\"go\":%lu,\"in\":%s,\"secure\":%s,"
           "\"arm\":%lu,\"phones\":%d,\"fw\":\"%s\",\"show\":%lu,\"role\":\"%s\",\"hold\":%.2f,"
           "\"imu\":%s,\"pitch\":%.2f,\"bump\":%s,\"bumpDeg\":%.2f,\"bumpWhy\":\"%s\",\"cfg\":",
           d, liveStr, (unsigned long)liveRate, recording ? "true" : "false", moved ? "true" : "false",
           (unsigned long)nSamples, (unsigned long)badFrames, (unsigned)limitCm, (unsigned)state, (unsigned long)sets, (unsigned long)goIdx,
           (validCm(d) && (gateCm == 0 || d < gateCm)) ? "true" : "false", certUntil[0] ? "true" : "false",
           (unsigned long)armId, phoneCount(), FW_VERSION, (unsigned long)showArm, role, (double)holdFrac,
           imu::ok ? "true" : "false", (double)imu::pitch, imu::bumped ? "true" : "false", (double)imu::bumpDeg, imu::bumpWhy);
  {
    String c = "\"";
    xSemaphoreTake(uiLock, portMAX_DELAY); jsonEscape(c, armCfg);
    c += "\",\"order\":"; c += (unsigned long)orderId; c += ",\"pick\":"; c += (unsigned long)pickId; c += ",\"pickName\":\""; jsonEscape(c, pickName);
    xSemaphoreGive(uiLock);
    c += "\"";
    // the waist pods: "pods" (all of them), "pod" (the first, for older copies of the app)
    xSemaphoreTake(uiLock, portMAX_DELAY);
    c += ",\"pods\":["; bool first = true; const pod::Slot* one = nullptr;
    for (auto& k : pod::s) if (k.id[0]) { if (!first) c += ","; pod::json(c, k); first = false; if (!one || (!pod::online(*one) && pod::online(k))) one = &k; }
    c += "]";
    if (one) { c += ",\"pod\":"; pod::json(c, *one); }
    xSemaphoreGive(uiLock);
    len += snprintf(json + len, cap - len, "%s", c.c_str());
  }
  if (from >= 0 && (state == ST_RUN || state == ST_DONE) && nSamples) {
    uint32_t n = nSamples, t0 = sBuf[0].t;
    uint32_t i = (uint32_t)from, k = 0;
    len += snprintf(json + len, cap - len, ",\"t0\":%lu,\"pts\":[", (unsigned long)t0);
    for (; i < n && k < 150 && len < (int)cap - 40; i += 20, k++) {
      len += snprintf(json + len, cap - len, "%s[%lu,%u]", k ? "," : "", (unsigned long)((sBuf[i].t - t0) / 1000), sBuf[i].d);
    }
    len += snprintf(json + len, cap - len, "],\"next\":%lu", (unsigned long)i);
  }
  len += snprintf(json + len, cap - len, "}");
  return len;
}
// /arm?stop=3150&gate=500&hold=1500&max=9900[&now=1]  (GET, or POST with the same as a form)
//   stop: sprint ends this far (cm) past the start (0 = vault, stops by itself)
//   gate: athlete must stand closer than this (cm) to arm (0 = anywhere)
//   hold: how long to stand still (ms) · max: ignore everything at or past this (cm), e.g. the box
//   now: skip the stand-still check and arm straight away
//   cfg: the run's setup as JSON (passed on to the other phones) · who, evs, evl, tgt: for the screen
String apiArm(const Params& p) {
  recording = false;
  delay(5);
  long stop = p.num("stop", 0), gate = p.num("gate", 0), hold = p.num("hold", 1500), mx = p.num("max", MAX_VALID_CM);
  stopCm  = stop > 0 ? (uint32_t)stop : 0;
  gateCm  = gate > 0 ? (uint16_t)gate : 0;
  holdMs  = hold > 0 ? (uint32_t)hold : 1500;
  limitCm = (uint16_t)(mx > 10 && mx < MAX_VALID_CM ? mx : MAX_VALID_CM);
  nSamples = 0; moved = false; goIdx = 0; holdFrac = 0;
  xSemaphoreTake(uiLock, portMAX_DELAY);
  armCfg = p.get("cfg"); if (armCfg.length() > 600) armCfg = "";
  if (p.has("roster")) { armRoster = p.get("roster"); if (armRoster.length() > 1500) armRoster = armRoster.substring(0, 1500); armLineup = p.num("lineup", 0); }
  strlcpy(armWho, p.get("who").c_str(), sizeof armWho);
  strlcpy(armEvS, p.get("evs", stopCm ? "SPRINT" : "VAULT").c_str(), sizeof armEvS);
  strlcpy(armEvL, p.get("evl").c_str(), sizeof armEvL);
  armTarget = p.get("tgt", "0").toFloat();
  uint32_t id = ++armId;
  xSemaphoreGive(uiLock);
  resetWait = true;
  if (imu::ok && !imu::refSet && !imu::cmd) imu::cmd = imu::C_LOCK;   // first run of the session: remember where it points
  if (p.has("now") && p.num("now", 1) != 0) { resetRun = true; recording = true; state = ST_SET; sets++; }
  else state = ST_WAIT;
  return String("{\"ok\":true,\"arm\":") + id + "}";
}
// /level: the tilt sensor. GET ?watch=1&at=30.48 keeps the level up on the sensor's screen for 2.5 s (the app
// polls it while its level screen is open). POST do=zero | zero1 | zero2 | front | lock | cancel.
String apiLevel(const Params& p) {
  String m;
  if (p.has("do")) {
    String d = p.get("do");
    int c = d == "zero" ? imu::C_ZERO : d == "zero1" ? imu::C_ZERO1 : d == "zero2" ? imu::C_ZERO2 : d == "front" ? imu::C_FRONT : d == "lock" ? imu::C_LOCK : d == "cancel" ? imu::C_CANCEL : 0;
    if (c) m = imu::command(c);
  }
  if (p.has("watch")) { levelUntil = millis() + 2500; float at = p.get("at", "0").toFloat(); if (at > 1 && at < 120) levelAtM = at; }
  String o; o.reserve(320);
  char b[300];
  snprintf(b, sizeof b, "{\"ok\":%s,\"pitch\":%.3f,\"roll\":%.3f,\"still\":%s,\"zeroed\":%s,\"half\":%s,\"front\":%s,\"ref\":%s,\"bump\":%s,\"bumpDeg\":%.2f,\"bumpWhy\":\"%s\",\"msg\":\"",
           imu::ok ? "true" : "false", (double)imu::pitchS, (double)imu::rollS, imu::still ? "true" : "false", imu::zeroed ? "true" : "false", imu::half ? "true" : "false",
           imu::fwdSet ? "true" : "false", imu::refSet ? "true" : "false", imu::bumped ? "true" : "false", (double)imu::bumpDeg, imu::bumpWhy);
  o += b; jsonEscape(o, m); o += "\"}";
  return o;
}
void doStop() { recording = false; state = ST_IDLE; holdFrac = 0; }
// /show (POST form): the result for the screen, sent by the phone that worked the run out
//   run: the arm number it belongs to · strip, h, hv, hu: heading, big number and its unit
//   k1..k4, v1..v4, u1..u4: up to four smaller values · fl, fr: footer left/right
String apiShow(const Params& p) {
  uint32_t run = p.num("run", 0);
  if (!run) return "{\"ok\":false}";
  xSemaphoreTake(uiLock, portMAX_DELAY);
  scr::Model& R = resultModel;
  strlcpy(R.strip, p.get("strip", "RUN SAVED").c_str(), sizeof R.strip);
  strlcpy(R.head, p.get("h").c_str(), sizeof R.head); strlcpy(R.headV, p.get("hv").c_str(), sizeof R.headV); strlcpy(R.headU, p.get("hu").c_str(), sizeof R.headU);
  R.nCells = 0;
  for (int i = 1; i <= 4; i++) {
    char kk[4], kv[4], ku[4]; snprintf(kk, 4, "k%d", i); snprintf(kv, 4, "v%d", i); snprintf(ku, 4, "u%d", i);
    if (!p.has(kk)) continue;
    scr::Cell& c = R.cells[R.nCells++];
    strlcpy(c.k, p.get(kk).c_str(), sizeof c.k); strlcpy(c.v, p.get(kv).c_str(), sizeof c.v); strlcpy(c.u, p.get(ku).c_str(), sizeof c.u);
  }
  strlcpy(R.footL, p.get("fl").c_str(), sizeof R.footL); strlcpy(R.footR, p.get("fr").c_str(), sizeof R.footR);
  R.vault = stopCm == 0;
  showArm = run; showAt = millis();
  xSemaphoreGive(uiLock);
  return "{\"ok\":true}";
}
// POST /jump who=&pod=&best=&next=[&res=1&h=&hs=&hm=&rw=] (from the app's Jump test, every second or so while it's open)
String apiPage(const Params& p) {
  xSemaphoreTake(uiLock, portMAX_DELAY);
  strlcpy(pagem::title, p.get("t").c_str(), sizeof pagem::title); strlcpy(pagem::k, p.get("k").c_str(), sizeof pagem::k);
  strlcpy(pagem::v, p.get("v").c_str(), sizeof pagem::v); strlcpy(pagem::u, p.get("u").c_str(), sizeof pagem::u); strlcpy(pagem::sub, p.get("sub").c_str(), sizeof pagem::sub);
  int n = 0;
  for (int i = 0; i < 3; i++) {
    char a[4]; snprintf(a, sizeof a, "k%d", i + 1); String ck = p.get(a); if (!ck.length()) break;
    strlcpy(pagem::c[n].k, ck.c_str(), sizeof pagem::c[n].k);
    a[0] = 'v'; strlcpy(pagem::c[n].v, p.get(a).c_str(), sizeof pagem::c[n].v);
    a[0] = 'u'; strlcpy(pagem::c[n].u, p.get(a).c_str(), sizeof pagem::c[n].u);
    n++;
  }
  pagem::n = n; pagem::live = p.num("live", 0) != 0;
  pagem::until = p.num("off", 0) ? 0 : millis() + 9000;
  xSemaphoreGive(uiLock);
  return "{\"ok\":true}";
}
String apiJump(const Params& p) {
  xSemaphoreTake(uiLock, portMAX_DELAY);
  jumpm::until = millis() + 3500;
  strlcpy(jumpm::who, p.get("who").c_str(), sizeof jumpm::who); strlcpy(jumpm::pod, p.get("pod").c_str(), sizeof jumpm::pod);
  strlcpy(jumpm::best, p.get("best").c_str(), sizeof jumpm::best); strlcpy(jumpm::next, p.get("next").c_str(), sizeof jumpm::next);
  jumpm::res = p.num("res", 0) != 0;
  strlcpy(jumpm::h, p.get("h").c_str(), sizeof jumpm::h); strlcpy(jumpm::hs, p.get("hs").c_str(), sizeof jumpm::hs);
  strlcpy(jumpm::hm, p.get("hm").c_str(), sizeof jumpm::hm); strlcpy(jumpm::rwho, p.get("rw").c_str(), sizeof jumpm::rwho);
  if (p.num("off", 0)) jumpm::until = 0;
  { int sph = (int)p.num("sph", -1);
    if (sph >= 0) { if (sph == 2 && jumpm::simPh != 2) jumpm::simAirAt = millis(); jumpm::simV = p.get("sv").toFloat(); jumpm::simPh = sph; jumpm::simUntil = millis() + 4000; }
    else jumpm::simPh = -1; }
  xSemaphoreGive(uiLock);
  return "{\"ok\":true}";
}
// /data: [n, limitCm] then n × [time µs (4), distance cm (2), signal (2)]
template <typename Send> void streamData(Send send) {
  recording = false;
  delay(5);
  uint32_t n = nSamples;
  uint32_t hdr[2] = {n, (uint32_t)limitCm};
  send((const char*)hdr, sizeof(hdr));
  static uint8_t chunk[8192];
  uint32_t i = 0;
  while (i < n) {
    size_t len = 0;
    while (i < n && len + 8 <= sizeof(chunk)) { memcpy(chunk + len, &sBuf[i], 8); len += 8; i++; }
    send((const char*)chunk, len);
  }
}

// ---- the sensor's key and certificate ----
// The private key is made on the sensor the first time it starts and never leaves it. The phone carries
// the certificate request (public) to GitHub once; a GitHub job gets the certificate from Let's Encrypt
// and renews it; the app brings each new certificate back here. A certificate is only accepted if it
// belongs to this sensor's key.
bool parseKey(mbedtls_pk_context* pk) {
  return mbedtls_pk_parse_key(pk, (const unsigned char*)keyPem.c_str(), keyPem.length() + 1, nullptr, 0, mbedtls_ctr_drbg_random, &drbg) == 0;
}
bool loadOrMakeKey() {
  keyPem = prefs.getString("key", "");
  if (keyPem.length()) return true;
  mbedtls_pk_context pk; mbedtls_pk_init(&pk);
  int r = mbedtls_pk_setup(&pk, mbedtls_pk_info_from_type(MBEDTLS_PK_ECKEY));
  if (!r) r = mbedtls_ecp_gen_key(MBEDTLS_ECP_DP_SECP256R1, mbedtls_pk_ec(pk), mbedtls_ctr_drbg_random, &drbg);
  static unsigned char buf[600];
  if (!r) r = mbedtls_pk_write_key_pem(&pk, buf, sizeof(buf));
  mbedtls_pk_free(&pk);
  if (r) return false;
  keyPem = String((const char*)buf);
  prefs.putString("key", keyPem);
  return true;
}
String makeCsr() {
  mbedtls_pk_context pk; mbedtls_pk_init(&pk);
  if (!parseKey(&pk)) { mbedtls_pk_free(&pk); return ""; }
  mbedtls_x509write_csr csr; mbedtls_x509write_csr_init(&csr);
  mbedtls_x509write_csr_set_md_alg(&csr, MBEDTLS_MD_SHA256);
  mbedtls_x509write_csr_set_key(&csr, &pk);
  String subj = String("CN=") + HOST;
  mbedtls_x509write_csr_set_subject_name(&csr, subj.c_str());
  // subjectAltName = DNS:HOST  (SEQUENCE { [2] IA5String })
  uint8_t san[80]; size_t hl = strlen(HOST);
  san[0] = 0x30; san[1] = (uint8_t)(hl + 2); san[2] = 0x82; san[3] = (uint8_t)hl; memcpy(san + 4, HOST, hl);
  mbedtls_x509write_csr_set_extension(&csr, MBEDTLS_OID_SUBJECT_ALT_NAME, MBEDTLS_OID_SIZE(MBEDTLS_OID_SUBJECT_ALT_NAME), 0, san, hl + 4);
  static unsigned char buf[1200];
  int r = mbedtls_x509write_csr_pem(&csr, buf, sizeof(buf), mbedtls_ctr_drbg_random, &drbg);
  mbedtls_x509write_csr_free(&csr); mbedtls_pk_free(&pk);
  return r ? String("") : String((const char*)buf);
}
// checks a certificate chain (PEM): parses, belongs to our key; fills its expiry
bool checkCert(const String& pem, char* until) {
  mbedtls_x509_crt crt; mbedtls_x509_crt_init(&crt);
  mbedtls_pk_context pk; mbedtls_pk_init(&pk);
  bool ok = mbedtls_x509_crt_parse(&crt, (const unsigned char*)pem.c_str(), pem.length() + 1) == 0 && parseKey(&pk)
         && mbedtls_pk_check_pair(&crt.pk, &pk, mbedtls_ctr_drbg_random, &drbg) == 0;
  if (ok && until) snprintf(until, 24, "%04d-%02d-%02dT%02d:%02d:%02dZ", crt.valid_to.year, crt.valid_to.mon, crt.valid_to.day, crt.valid_to.hour, crt.valid_to.min, crt.valid_to.sec);
  mbedtls_x509_crt_free(&crt); mbedtls_pk_free(&pk);
  return ok;
}
// a new certificate from the app: saved only if it's for this sensor
const char* installCert(const String& pem) {
  if (pem.length() < 200 || pem.length() > 8000) return "not a certificate";
  char until[24];
  if (!checkCert(pem, until)) return "that certificate isn't for this sensor";
  if (strcmp(until, certUntil) < 0) return "older than the one installed";
  prefs.putBytes("crt", pem.c_str(), pem.length() + 1);
  crtPem = pem; strcpy(certUntil, until);
  restartHttpsAt = millis() + 500;   // after this reply has gone out
  return nullptr;
}
size_t buildTls(char* json, size_t cap) {
  return snprintf(json, cap, "{\"host\":\"%s\",\"secure\":%s,\"until\":%s%s%s,\"running\":%s,\"heap\":%lu,\"biggest\":%lu,\"lowest\":%lu,\"psram\":%lu,\"fw\":\"%s\",\"up\":%lu,\"reset\":\"%s\",\"boots\":%lu}", HOST, certUntil[0] ? "true" : "false",
                  certUntil[0] ? "\"" : "", certUntil[0] ? certUntil : "null", certUntil[0] ? "\"" : "", https ? "true" : "false", (unsigned long)ESP.getFreeHeap(),
                  (unsigned long)ESP.getMaxAllocHeap(), (unsigned long)ESP.getMinFreeHeap(), (unsigned long)ESP.getFreePsram(), FW_VERSION,
                  (unsigned long)(millis() / 1000), resetWhy, (unsigned long)bootCount);
}

// ---- firmware update over Wi-Fi: POST /update with the .bin as the body ----
bool updBegin(size_t total) {
  if (Update.isRunning()) Update.abort();
  updating = true; updatePct = 0;
  recording = false; state = ST_IDLE;
  if (!Update.begin(total ? total : UPDATE_SIZE_UNKNOWN)) { updating = false; return false; }
  return true;
}
bool updWrite(uint8_t* p, size_t n, size_t done, size_t total) {
  if (Update.write(p, n) != n) return false;
  if (total) updatePct = (int)(100.0 * done / total);
  return true;
}
String updEnd(bool ok) {
  if (ok && Update.end(true)) { updatePct = 100; rebootAt = millis() + 1500; return "{\"ok\":true}"; }
  String e = Update.errorString(); Update.abort(); updating = false;
  return String("{\"ok\":false,\"error\":\"") + e + "\"}";
}

// ---- https handlers ----
static const Asset A_PAGE  = {"text/html; charset=utf-8", PAGE_GZ, PAGE_GZ_LEN, "no-cache", true};
static const Asset A_SW    = {"application/javascript", ASSET_SW, ASSET_SW_LEN, "no-cache", false};
static const Asset A_MAN   = {"application/manifest+json", ASSET_MANIFEST, ASSET_MANIFEST_LEN, "max-age=86400", false};
static const Asset A_TOUCH = {"image/png", ASSET_APPLE_TOUCH_ICON, ASSET_APPLE_TOUCH_ICON_LEN, "max-age=86400", false};
static const Asset A_I192  = {"image/png", ASSET_ICON_192, ASSET_ICON_192_LEN, "max-age=86400", false};
static const Asset A_I512  = {"image/png", ASSET_ICON_512, ASSET_ICON_512_LEN, "max-age=86400", false};
static const Asset A_IMASK = {"image/png", ASSET_ICON_MASKABLE_512, ASSET_ICON_MASKABLE_512_LEN, "max-age=86400", false};
static const Asset A_FAV   = {"image/png", ASSET_FAVICON_32, ASSET_FAVICON_32_LEN, "max-age=86400", false};

// query string + (for a form POST) the body
static Params hsParams(httpd_req_t* r) {
  Params p;
  size_t ql = httpd_req_get_url_query_len(r);
  if (ql) { char* q = (char*)malloc(ql + 1); if (q && httpd_req_get_url_query_str(r, q, ql + 1) == ESP_OK) p.raw = q; free(q); }
  if (r->method == HTTP_POST && r->content_len > 0 && r->content_len < 8192) {
    String body; body.reserve(r->content_len + 1);
    char buf[512]; int left = r->content_len;
    while (left > 0) { int got = httpd_req_recv(r, buf, left < (int)sizeof(buf) ? left : sizeof(buf)); if (got <= 0) break; body.concat(buf, got); left -= got; }
    if (p.raw.length()) p.raw += "&";
    p.raw += body;
  }
  return p;
}
static esp_err_t hsJson(httpd_req_t* r, const String& s) {
  httpd_resp_set_type(r, "application/json"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  return httpd_resp_send(r, s.c_str(), s.length());
}
static esp_err_t hsAsset(httpd_req_t* r) {
  const Asset* a = (const Asset*)r->user_ctx;
  httpd_resp_set_type(r, a->type);
  httpd_resp_set_hdr(r, "Cache-Control", a->cache);
  if (a->gz) httpd_resp_set_hdr(r, "Content-Encoding", "gzip");
  return httpd_resp_send(r, (const char*)a->data, a->len);
}
static esp_err_t hsLive(httpd_req_t* r) {
  static char json[4600];
  Params p = hsParams(r);
  size_t n = buildLive(json, sizeof(json), p.has("from") ? p.num("from", -1) : -1, roleFor(p.get("dev")));
  httpd_resp_set_type(r, "application/json"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  return httpd_resp_send(r, json, n);
}
static esp_err_t hsArm(httpd_req_t* r) { return hsJson(r, apiArm(hsParams(r))); }
static esp_err_t hsShow(httpd_req_t* r) { return hsJson(r, apiShow(hsParams(r))); }
static esp_err_t hsClaim(httpd_req_t* r) { return hsJson(r, apiClaim(hsParams(r))); }
static esp_err_t hsScreen(httpd_req_t* r) { return hsJson(r, apiScreen()); }
static esp_err_t hsPick(httpd_req_t* r) { return hsJson(r, apiPick(hsParams(r))); }
static esp_err_t hsOrder(httpd_req_t* r) { return hsJson(r, apiOrder(hsParams(r))); }
static esp_err_t hsStop(httpd_req_t* r) { doStop(); return httpd_resp_sendstr(r, "stopped"); }
static esp_err_t hsLevel(httpd_req_t* r) { return hsJson(r, apiLevel(hsParams(r))); }
static esp_err_t hsJump(httpd_req_t* r) { return hsJson(r, apiJump(hsParams(r))); }
static esp_err_t hsPage(httpd_req_t* r) { return hsJson(r, apiPage(hsParams(r))); }
static esp_err_t hsPodCmd(httpd_req_t* r) { return hsJson(r, apiPodCmd(hsParams(r))); }
static esp_err_t hsPodData(httpd_req_t* r) {
  httpd_resp_set_type(r, "application/octet-stream"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  pod::Slot* k = pod::pick(hsParams(r).get("id"));
  static char offS[16]; offS[0] = 0;
  if (k && k->offOk) { snprintf(offS, sizeof offS, "%lu", (unsigned long)k->off); httpd_resp_set_hdr(r, "X-Pod-Off", offS); }
  return httpd_resp_send(r, k && k->buf ? (const char*)k->buf : "", k && k->buf ? k->len : 0);
}
static esp_err_t hsPodFw(httpd_req_t* r) {
  PodSink k; size_t total = r->content_len;
  if (!podSinkBegin(k, total, true, String())) return hsJson(r, "{\"ok\":false,\"error\":\"too big\"}");
  static uint8_t b[4096]; size_t done = 0;
  while (done < total) { int got = httpd_req_recv(r, (char*)b, total - done < sizeof b ? total - done : sizeof b); if (got == HTTPD_SOCK_ERR_TIMEOUT) continue; if (got <= 0) break; podSinkWrite(k, b, got); done += got; }
  if (done != total) k.ok = false;
  return hsJson(r, podSinkEnd(k, true));
}
static esp_err_t hsAbout(httpd_req_t* r) { aboutUntil = millis() + 20000; return httpd_resp_sendstr(r, "about"); }
static esp_err_t hsData(httpd_req_t* r) {
  httpd_resp_set_type(r, "application/octet-stream"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  streamData([r](const char* p, size_t n) { httpd_resp_send_chunk(r, p, n); });
  return httpd_resp_send_chunk(r, nullptr, 0);
}
static esp_err_t hsTls(httpd_req_t* r) {
  char json[360]; size_t n = buildTls(json, sizeof(json));
  httpd_resp_set_type(r, "application/json"); httpd_resp_set_hdr(r, "Cache-Control", "no-store");
  return httpd_resp_send(r, json, n);
}
static esp_err_t hsCertPost(httpd_req_t* r) {
  if (r->content_len > 8000) return httpd_resp_send_err(r, HTTPD_400_BAD_REQUEST, "too big");
  String body; body.reserve(r->content_len + 1);
  char buf[512]; int left = r->content_len;
  while (left > 0) { int got = httpd_req_recv(r, buf, left < (int)sizeof(buf) ? left : sizeof(buf)); if (got <= 0) return ESP_FAIL; body.concat(buf, got); left -= got; }
  const char* err = installCert(body);
  if (err) return hsJson(r, String("{\"ok\":false,\"error\":\"") + err + "\"}");
  return hsJson(r, "{\"ok\":true}");
}
static esp_err_t hsUpdate(httpd_req_t* r) {
  size_t total = r->content_len, done = 0;
  if (!total) return hsJson(r, "{\"ok\":false,\"error\":\"the file arrived empty\"}");
  if (!updBegin(total)) {   // say why: "No Partition" means it was flashed over USB with a scheme that has one app slot
    String e = Update.errorString(); Update.abort(); e.replace("\"", "'");
    bool noSlot = esp_ota_get_next_update_partition(NULL) == NULL;
    return hsJson(r, String("{\"ok\":false,\"error\":\"") + (noSlot ? "this board has no second app slot, so it can't update over Wi-Fi. Flash it once over USB with Partition Scheme '16M Flash (3MB APP/9.9MB FATFS)'" : "couldn't start the update (" + e + ")") + "\"}");
  }
  static uint8_t buf[4096]; bool ok = true;
  while (done < total) {
    int got = httpd_req_recv(r, (char*)buf, total - done < sizeof(buf) ? total - done : sizeof(buf));
    if (got == HTTPD_SOCK_ERR_TIMEOUT) continue;
    if (got <= 0) { ok = false; break; }
    done += got;
    if (!updWrite(buf, got, done, total)) { ok = false; break; }
  }
  return hsJson(r, updEnd(ok && done == total));
}
void startHttps() {
  if (https) { httpd_ssl_stop(https); https = nullptr; }
  if (!certUntil[0]) return;
  httpd_ssl_config_t c = HTTPD_SSL_CONFIG_DEFAULT();
  c.servercert = (const uint8_t*)crtPem.c_str(); c.servercert_len = crtPem.length() + 1;
  c.prvtkey_pem = (const uint8_t*)keyPem.c_str(); c.prvtkey_len = keyPem.length() + 1;
  // Several phones at once: each secure connection's buffers (~40 KB) go to PSRAM, so there's room for
  // a couple of connections per device. Old idle ones are closed first when it's full.
  c.httpd.max_open_sockets = 8;
  c.httpd.lru_purge_enable = true;
  c.httpd.max_uri_handlers = 40;
  c.httpd.stack_size = 12288;
  c.httpd.recv_wait_timeout = 10;
  c.httpd.send_wait_timeout = 10;
  if (httpd_ssl_start(&https, &c) != ESP_OK) { https = nullptr; Serial.println("https didn't start"); return; }
  auto on = [](const char* uri, httpd_method_t m, esp_err_t (*h)(httpd_req_t*), const void* ctx) {
    httpd_uri_t u = {}; u.uri = uri; u.method = m; u.handler = h; u.user_ctx = (void*)ctx; httpd_register_uri_handler(https, &u);
  };
  on("/", HTTP_GET, hsAsset, &A_PAGE);
  on("/index.html", HTTP_GET, hsAsset, &A_PAGE);
  on("/sw.js", HTTP_GET, hsAsset, &A_SW);
  on("/manifest.webmanifest", HTTP_GET, hsAsset, &A_MAN);
  on("/icons/apple-touch-icon.png", HTTP_GET, hsAsset, &A_TOUCH);
  on("/apple-touch-icon.png", HTTP_GET, hsAsset, &A_TOUCH);
  on("/icons/icon-192.png", HTTP_GET, hsAsset, &A_I192);
  on("/icons/icon-512.png", HTTP_GET, hsAsset, &A_I512);
  on("/icons/icon-maskable-512.png", HTTP_GET, hsAsset, &A_IMASK);
  on("/icons/favicon-32.png", HTTP_GET, hsAsset, &A_FAV);
  on("/live", HTTP_GET, hsLive, nullptr);
  on("/arm", HTTP_GET, hsArm, nullptr);
  on("/arm", HTTP_POST, hsArm, nullptr);
  on("/show", HTTP_POST, hsShow, nullptr);
  on("/stop", HTTP_GET, hsStop, nullptr);
  on("/about", HTTP_POST, hsAbout, nullptr);
  on("/level", HTTP_GET, hsLevel, nullptr);
  on("/level", HTTP_POST, hsLevel, nullptr);
  on("/jump", HTTP_POST, hsJump, nullptr);
  on("/page", HTTP_POST, hsPage, nullptr);
  on("/pod/cmd", HTTP_POST, hsPodCmd, nullptr);
  on("/pod/data", HTTP_GET, hsPodData, nullptr);
  on("/pod/fw", HTTP_POST, hsPodFw, nullptr);
  on("/claim", HTTP_GET, hsClaim, nullptr);
  on("/claim", HTTP_POST, hsClaim, nullptr);
  on("/screen", HTTP_GET, hsScreen, nullptr);
  on("/pick", HTTP_GET, hsPick, nullptr);
  on("/pick", HTTP_POST, hsPick, nullptr);
  on("/order", HTTP_POST, hsOrder, nullptr);
  on("/data", HTTP_GET, hsData, nullptr);
  on("/tls", HTTP_GET, hsTls, nullptr);
  on("/cert", HTTP_POST, hsCertPost, nullptr);
  on("/update", HTTP_POST, hsUpdate, nullptr);
  Serial.printf("Secure: https://%s (certificate until %s)\n", HOST, certUntil);
}

// ---- http (setup and fallback) ----
void sendAsset(const Asset& a) {
  server.sendHeader("Cache-Control", a.cache);
  if (a.gz) server.sendHeader("Content-Encoding", "gzip");
  server.send_P(200, a.type, (const char*)a.data, a.len);
}
void handleRoot() {
  // once the secure address works, send the phone there (?here=1 keeps the plain copy, e.g. for setup)
  if (certUntil[0] && https && !server.hasArg("here")) { server.sendHeader("Location", String("https://") + HOST + "/"); server.send(302, "text/plain", ""); return; }
  sendAsset(A_PAGE);
}
void handleData() {
  server.sendHeader("Cache-Control", "no-store");
  server.setContentLength(8 + (size_t)nSamples * 8);
  server.send(200, "application/octet-stream", "");
  streamData([](const char* p, size_t n) { server.sendContent(p, n); });
}
static Params wsParams() { Params p; p.ws = &server; return p; }
// one raw upload at a time per kind (the recording / pod firmware)
void podRaw(bool firmware) {
  static PodSink sinks[2]; static size_t totals[2];
  PodSink& k = sinks[firmware]; size_t& total = totals[firmware];
  HTTPRaw& raw = server.raw();
  if (raw.status == RAW_START) { total = server.header("Content-Length").toInt(); podSinkBegin(k, total, firmware, server.arg("id")); }
  else if (raw.status == RAW_WRITE) podSinkWrite(k, raw.buf, raw.currentSize);
  else if (raw.status == RAW_END) { if (k.got != total) k.ok = false; wsJson(podSinkEnd(k, firmware)); }
  else if (raw.status == RAW_ABORTED) k.ok = false;
}
static void wsJson(const String& s) { server.sendHeader("Cache-Control", "no-store"); server.send(200, "application/json", s); }

void setup() {
  Serial.begin(115200);
  uiLock = xSemaphoreCreateMutex();

  // The run buffer and the screen's frame live in PSRAM (8 MB on the N16R8).
  if (!psramFound()) { Serial.println("No PSRAM: Tools > PSRAM > \"OPI PSRAM\""); }
  sBuf = (Sample*)ps_malloc(MAX_SAMPLES * sizeof(Sample));
  scr::fb = (uint16_t*)ps_malloc(scr::W * scr::H * 2);
  if (!sBuf || !scr::fb) {
    Serial.println("Not enough memory: is PSRAM turned on? (Tools > PSRAM > OPI PSRAM)");
    while (true) delay(1000);
  }
  tftInit();
  xTaskCreatePinnedToCore(screenTask, "screen", 8192, nullptr, 1, nullptr, 0);

  Serial1.setRxBufferSize(8192);
  Serial1.begin(115200, SERIAL_8N1, PIN_LIDAR_RX, PIN_LIDAR_TX);
  delay(500);
  configureLidar();

  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS, 1, 0, MAX_DEVICES);
  WiFi.setSleep(false);
  delay(100);
  // answer the sensor's own name on this Wi-Fi, so the secure address works with no internet
  dns.setErrorReplyCode(DNSReplyCode::NonExistentDomain);
  dns.start(53, HOST, WiFi.softAPIP());

  // key + certificate
  mbedtls_entropy_init(&entropy); mbedtls_ctr_drbg_init(&drbg);
  mbedtls_ctr_drbg_seed(&drbg, mbedtls_entropy_func, &entropy, (const unsigned char*)"speedlidar", 10);
  prefs.begin("tls", false);
  resetWhy = resetName(esp_reset_reason()); bootCount = prefs.getUInt("boots", 0) + 1; prefs.putUInt("boots", bootCount);
  Serial.printf("Start #%lu, last stop: %s\n", (unsigned long)bootCount, resetWhy);
  if (!loadOrMakeKey()) Serial.println("Couldn't make the sensor's key");
  size_t cl = prefs.getBytesLength("crt");
  if (cl > 0 && cl <= 8001) {
    char* b = (char*)malloc(cl); prefs.getBytes("crt", b, cl); crtPem = String(b); free(b);
    if (!checkCert(crtPem, certUntil)) { certUntil[0] = 0; crtPem = ""; }
  }
  startHttps();
  Serial.printf("Open http://%s  (free memory %lu, PSRAM %lu)\n", WiFi.softAPIP().toString().c_str(), (unsigned long)ESP.getFreeHeap(), (unsigned long)ESP.getFreePsram());

  server.on("/", handleRoot);
  server.on("/index.html", handleRoot);
  server.on("/live", [] { static char json[4600]; buildLive(json, sizeof(json), server.hasArg("from") ? server.arg("from").toInt() : -1, roleFor(server.arg("dev")));
                          server.sendHeader("Cache-Control", "no-store"); server.send(200, "application/json", json); });
  server.on("/arm", [] { wsJson(apiArm(wsParams())); });
  server.on("/show", HTTP_POST, [] { wsJson(apiShow(wsParams())); });
  server.on("/stop", [] { doStop(); server.send(200, "text/plain", "stopped"); });
  server.on("/level", [] { wsJson(apiLevel(wsParams())); });
  server.on("/jump", [] { wsJson(apiJump(wsParams())); });
  server.on("/page", [] { wsJson(apiPage(wsParams())); });
  server.on("/pod/hello", [] { wsJson(apiPodHello(wsParams())); });
  server.on("/pod/cmd", [] { wsJson(apiPodCmd(wsParams())); });
  server.on("/pod/data", [] { server.sendHeader("Cache-Control", "no-store"); pod::Slot* k = pod::pick(server.arg("id"));
    if (k && k->offOk) server.sendHeader("X-Pod-Off", String((unsigned long)k->off)); server.send_P(200, "application/octet-stream", k && k->buf ? (const char*)k->buf : "", k && k->buf ? k->len : 0); });
  server.on("/pod/fw.bin", [] {
    if (!pod::fwBuf || !pod::fwLen) { server.send(404, "text/plain", "no pod firmware"); return; }
    server.send_P(200, "application/octet-stream", (const char*)pod::fwBuf, pod::fwLen);
  });
  // raw bodies: the pod's recording, and pod firmware from the app's fallback copy
  server.on("/pod/push", HTTP_POST, [] {}, [] { podRaw(false); });
  server.on("/pod/fw", HTTP_POST, [] {}, [] { podRaw(true); });
  server.on("/about", HTTP_POST, [] { aboutUntil = millis() + 20000; server.send(200, "text/plain", "about"); });
  server.on("/claim", [] { wsJson(apiClaim(wsParams())); });
  server.on("/screen", [] { wsJson(apiScreen()); });
  server.on("/pick", [] { wsJson(apiPick(wsParams())); });
  server.on("/order", HTTP_POST, [] { wsJson(apiOrder(wsParams())); });
  server.on("/data", handleData);
  server.on("/tls", [] { char json[420]; buildTls(json, sizeof(json)); server.sendHeader("Cache-Control", "no-store"); server.send(200, "application/json", json); });
  server.on("/csr", [] { server.sendHeader("Cache-Control", "no-store"); server.send(200, "text/plain", makeCsr()); });
  server.on("/cert", HTTP_POST, [] {
    const char* err = installCert(server.arg("plain"));
    server.send(200, "application/json", err ? String("{\"ok\":false,\"error\":\"") + err + "\"}" : String("{\"ok\":true}"));
  });
  // firmware update: the .bin as the raw body (application/octet-stream)
  server.on("/update", HTTP_POST, [] {}, [] {
    static bool ok = true; static size_t done = 0, total = 0;
    HTTPRaw& raw = server.raw();
    if (raw.status == RAW_START) { total = server.header("Content-Length").toInt(); done = 0; ok = updBegin(total); }
    else if (raw.status == RAW_WRITE && ok) { done += raw.currentSize; ok = updWrite(raw.buf, raw.currentSize, done, total); }
    else if (raw.status == RAW_END) wsJson(updEnd(ok));
    else if (raw.status == RAW_ABORTED) { Update.abort(); updating = false; }
  });
  server.on("/sw.js", [] { sendAsset(A_SW); });
  server.on("/manifest.webmanifest", [] { sendAsset(A_MAN); });
  server.on("/icons/apple-touch-icon.png", [] { sendAsset(A_TOUCH); });
  server.on("/apple-touch-icon.png", [] { sendAsset(A_TOUCH); });
  server.on("/icons/icon-192.png", [] { sendAsset(A_I192); });
  server.on("/icons/icon-512.png", [] { sendAsset(A_I512); });
  server.on("/icons/icon-maskable-512.png", [] { sendAsset(A_IMASK); });
  server.on("/icons/favicon-32.png", [] { sendAsset(A_FAV); });
  server.on("/favicon.ico", [] { sendAsset(A_FAV); });
  const char* hdrs[] = {"Content-Length"}; server.collectHeaders(hdrs, 1);
  server.begin();

  // Arduino IDE uploads over Wi-Fi (network port "speedlidar")
  ArduinoOTA.setHostname("speedlidar");
  ArduinoOTA.setPassword(AP_PASS);
  ArduinoOTA.onStart([] { updating = true; updatePct = 0; recording = false; state = ST_IDLE; });
  ArduinoOTA.onProgress([](unsigned int a, unsigned int b) { updatePct = b ? (int)(100.0 * a / b) : 0; });
  ArduinoOTA.onError([](ota_error_t) { updating = false; });
  ArduinoOTA.begin();

  xTaskCreatePinnedToCore(lidarTask, "lidar", 4096, nullptr, 3, nullptr, 1);
  xTaskCreatePinnedToCore(imu::task, "imu", 4096, nullptr, 2, nullptr, 0);
}

void loop() {
  dns.processNextRequest();
  server.handleClient();
  ArduinoOTA.handle();
  if (restartHttpsAt && (int32_t)(millis() - restartHttpsAt) >= 0) { restartHttpsAt = 0; startHttps(); }
  if (rebootAt && (int32_t)(millis() - rebootAt) >= 0) ESP.restart();
  delay(1);
}
