static inline bool validCm(uint16_t d) { return d > 10 && d < limitCm; }

// ---------------- arming: an athlete has to stand still at the start ----------------
// returns true once someone has stood within the gate, still, for holdMs
bool standCheck(uint32_t nowMs, uint16_t d) {
  static uint16_t anchor = 0, off = 0;
  static uint32_t since = 0, lastOk = 0;
  if (resetWait) { resetWait = false; anchor = 0; since = 0; lastOk = 0; off = 0; }
  bool inZone = validCm(d) && (gateCm == 0 || d < gateCm);
  if (!inZone) {
    if (since && nowMs - lastOk > STILL_GAP_MS) { since = 0; holdFrac = 0; }   // left, or someone walked through
    return false;
  }
  lastOk = nowMs;
  if (!since) { anchor = d; since = nowMs; off = 0; holdFrac = 0; return false; }
  if (d > anchor + STILL_CM || d + STILL_CM < anchor) {
    // one odd reading (arm, pole, noise) doesn't count; 60 ms in a row away from the spot means they moved
    if (++off > 60) { anchor = d; since = nowMs; off = 0; holdFrac = 0; }
    return false;
  }
  off = 0;
  float f = (float)(nowMs - since) / holdMs; holdFrac = f > 1 ? 1 : f;
  return nowMs - since >= holdMs;
}

// ---------------- recording ----------------
void storeSample(uint32_t now, uint16_t d, uint16_t s) {
  static uint32_t lostCount = 0;
  static uint16_t fastCount = 0;   // consecutive readings that look like sprinting
  static uint32_t stopAt    = 0;   // distance (cm) where a sprint test ends
  static uint32_t tail      = 0;   // readings kept after the target, so the finish isn't cut short
  static uint32_t away      = 0;   // armed, but nobody standing at the start
  static uint16_t backCnt   = 0;

  if (resetRun) {               // armed: start a fresh buffer
    resetRun = false;
    nSamples = 0; moved = false; lostCount = 0; fastCount = 0; stopAt = 0; tail = 0; away = 0; goIdx = 0; backCnt = 0;
  }
  if (nSamples >= MAX_SAMPLES) { recording = false; state = ST_DONE; return; }

  sBuf[nSamples] = {now, d, s};
  nSamples++;

  if (validCm(d)) {
    lostCount = 0;
    if (!moved && nSamples > MOVE_WINDOW) {
      uint16_t back = sBuf[nSamples - 1 - MOVE_WINDOW].d;
      if (validCm(back) && d > back + MOVE_START_CM) {
        if (++fastCount >= 50) {
          moved = true; state = ST_RUN; goIdx = nSamples;
          if (stopCm) {
            // start position = closest reading in the 1.5 s before the run was confirmed
            uint16_t start = 0xFFFF;
            uint32_t from = nSamples > 1500 ? nSamples - 1500 : 0;
            for (uint32_t i = from; i < nSamples; i++) { uint16_t x = sBuf[i].d; if (validCm(x) && x < start) start = x; }
            stopAt = (start == 0xFFFF ? back : start) + stopCm;
          }
        }
      }
      else fastCount = 0;
    }
  } else {
    lostCount++;
  }

  if (!moved) {
    // Armed and waiting at the start. If the athlete walks off (or out of the zone) instead of running,
    // go back to waiting so the next person has to stand in again. There's no time limit while they stay.
    bool atStart = validCm(d) && (gateCm == 0 || d < gateCm + 200);
    // (a stray close reading doesn't count as being back at the start: needs 30 ms in a row)
    if (atStart) { if (++backCnt > 30) away = 0; } else { backCnt = 0; away++; }
    if (away >= AWAY_MS) { recording = false; resetWait = true; state = ST_WAIT; return; }
    // only keep the most recent PRE_ROLL samples
    if (nSamples >= PRE_ROLL + 1000) {
      memmove(sBuf, sBuf + 1000, (nSamples - 1000) * sizeof(Sample));
      nSamples -= 1000;
    }
    return;
  }

  // Sprint test: past the target distance → keep 0.3 s more, then stop.
  if (stopAt && validCm(d) && d >= stopAt) tail++;
  if (tail >= 300) { recording = false; state = ST_DONE; return; }

  // Run in progress: stop when the target is lost or nothing moves for 1.5 s
  // (vault: after takeoff the athlete is past the box, which counts as lost).
  if (lostCount >= STOP_WINDOW) { recording = false; state = ST_DONE; return; }
  if (nSamples > STOP_WINDOW && nSamples % 100 == 0 && validCm(d)) {
    uint32_t off = 0;
    for (uint32_t i = nSamples - STOP_WINDOW; i < nSamples; i++) {
      uint16_t x = sBuf[i].d;
      if (!validCm(x) || x > d + 30 || x + 30 < d) off++;
    }
    if (off < STOP_WINDOW / 20) { recording = false; state = ST_DONE; }
  }
}

// one reading from the sensor
void onFrame(uint32_t nowUs, uint16_t d, uint16_t s) {
  if (state == ST_WAIT && standCheck(nowUs / 1000, d)) {
    resetRun = true; recording = true; state = ST_SET; sets++; holdFrac = 0;
  }
  if (recording) storeSample(nowUs, d, s);
}

// ---------------- LiDAR reader (own task so Wi-Fi never delays it) ----------------
void lidarTask(void*) {
  uint8_t  buf[9];
  int      idx = 0;
  uint32_t frames = 0, sigN = 0, sigOk = 0;
  uint32_t rateT0 = micros(), sigT0 = rateT0;

  for (;;) {
    while (Serial1.available()) {
      uint8_t b = Serial1.read();
      if (idx == 0 && b != 0x59) continue;            // frame header 0x59 0x59
      if (idx == 1 && b != 0x59) { idx = 0; continue; }
      buf[idx++] = b;
      if (idx < 9) continue;
      idx = 0;

      uint8_t sum = 0;
      for (int i = 0; i < 8; i++) sum += buf[i];
      if (sum != buf[8]) { badFrames++; continue; }

      uint32_t now = micros();
      uint16_t d = buf[2] | (buf[3] << 8);
      uint16_t s = buf[4] | (buf[5] << 8);
      liveDist = d;
      liveStr  = s;
      frames++; sigN++; if (validCm(d) && (gateCm == 0 || d < gateCm)) sigOk++;
      onFrame(now, d, s);
    }
    uint32_t now = micros();
    if (now - rateT0 >= 1000000) { liveRate = frames; frames = 0; rateT0 = now; }
    if (now - sigT0 >= 250000) { liveSig = sigN ? (uint8_t)(100 * sigOk / sigN) : 0; sigN = sigOk = 0; sigT0 = now; }
    vTaskDelay(1);
  }
}

void configureLidar() {
  // Set frame rate: 5A 06 03 LL HH checksum (not saved to flash; sent every boot)
  uint8_t cmd[6] = {0x5A, 0x06, 0x03, (uint8_t)(FRAME_RATE_HZ & 0xFF), (uint8_t)(FRAME_RATE_HZ >> 8), 0};
  uint8_t sum = 0;
  for (int i = 0; i < 5; i++) sum += cmd[i];
  cmd[5] = sum;
  Serial1.write(cmd, sizeof(cmd));
  delay(100);
  while (Serial1.available()) Serial1.read();   // discard the reply
}

// ---------------- the screen (ST7789, 170 × 320, used sideways) ----------------
SPIClass tftSpi(FSPI);
static uint8_t* lineBuf = nullptr;   // one row, byte-swapped for the panel (internal RAM)

static void tftCmd(uint8_t c, const uint8_t* data = nullptr, size_t n = 0) {
  digitalWrite(PIN_TFT_DC, LOW); digitalWrite(PIN_TFT_CS, LOW);
  tftSpi.transfer(c);
  if (n) { digitalWrite(PIN_TFT_DC, HIGH); tftSpi.writeBytes(data, n); }
  digitalWrite(PIN_TFT_CS, HIGH);
}
static void tftInit() {
  pinMode(PIN_TFT_CS, OUTPUT); pinMode(PIN_TFT_DC, OUTPUT); pinMode(PIN_TFT_RST, OUTPUT); pinMode(PIN_TFT_BL, OUTPUT);
  digitalWrite(PIN_TFT_CS, HIGH); digitalWrite(PIN_TFT_BL, LOW);
  tftSpi.begin(PIN_TFT_SCK, -1, PIN_TFT_MOSI, -1);
  tftSpi.beginTransaction(SPISettings(SCREEN_SPI_HZ, MSBFIRST, SPI_MODE0));   // only the screen uses this bus
  digitalWrite(PIN_TFT_RST, HIGH); delay(5); digitalWrite(PIN_TFT_RST, LOW); delay(20); digitalWrite(PIN_TFT_RST, HIGH); delay(150);
  tftCmd(0x01); delay(150);                         // software reset
  tftCmd(0x11); delay(120);                         // wake up
  uint8_t colmod = 0x55; tftCmd(0x3A, &colmod, 1);  // 16-bit colour
  // sideways: MV (+ MX, or MY for upside down); RGB/BGR order
  uint8_t mad = (SCREEN_FLIP ? 0xA0 : 0x60) | (SCREEN_BGR ? 0x08 : 0x00); tftCmd(0x36, &mad, 1);
  tftCmd(SCREEN_INVERT ? 0x21 : 0x20);
  tftCmd(0x13); tftCmd(0x29); delay(20);
  lineBuf = (uint8_t*)heap_caps_malloc(scr::W * 2, MALLOC_CAP_DMA | MALLOC_CAP_INTERNAL);
}
static void tftPush() {
  // 320 × 170 in landscape: the 170-pixel side sits 35 rows into the controller's 240-row memory
  const uint16_t x0 = 0, x1 = scr::W - 1, y0 = 35, y1 = 35 + scr::H - 1;
  uint8_t ca[4] = {(uint8_t)(x0 >> 8), (uint8_t)x0, (uint8_t)(x1 >> 8), (uint8_t)x1}; tftCmd(0x2A, ca, 4);
  uint8_t ra[4] = {(uint8_t)(y0 >> 8), (uint8_t)y0, (uint8_t)(y1 >> 8), (uint8_t)y1}; tftCmd(0x2B, ra, 4);
  digitalWrite(PIN_TFT_DC, LOW); digitalWrite(PIN_TFT_CS, LOW); tftSpi.transfer(0x2C); digitalWrite(PIN_TFT_DC, HIGH);
  for (int y = 0; y < scr::H; y++) {
    const uint16_t* row = scr::fb + y * scr::W;
    for (int x = 0; x < scr::W; x++) { lineBuf[2 * x] = row[x] >> 8; lineBuf[2 * x + 1] = row[x] & 0xFF; }
    tftSpi.writeBytes(lineBuf, scr::W * 2);
  }
  digitalWrite(PIN_TFT_CS, HIGH);
}

// live speed for the screen: straight-line fit of distance against time over the last 0.3 s
static float liveSpeed(uint32_t n) {
  if (n < 50) return 0;
  uint32_t tEnd = sBuf[n - 1].t; double st = 0, sd = 0, stt = 0, std_ = 0; int m = 0;
  for (uint32_t i = n; i-- > 0 && m < 400;) {
    const Sample& p = sBuf[i]; if (tEnd - p.t > 300000) break;
    if (!validCm(p.d)) continue;
    double t = (int32_t)(p.t - tEnd) / 1e6, d = p.d / 100.0; st += t; sd += d; stt += t * t; std_ += t * d; m++;
  }
  if (m < 20) return 0;
  double den = m * stt - st * st; if (den <= 0) return 0;
  double v = (m * std_ - st * sd) / den; return v > 0 && v < 15 ? (float)v : 0;
}


// ---------------- tilt sensor (BMI160) ----------------
// A digital level for the tripod, the beam's height down the runway, and a bump alarm. It reads 100 times a
// second. "Up" (gravity) and "front" (the beam) are learned in the sensor's own frame, so it doesn't matter how
// the chip sits on its board or how its board sits in the case:
//   zero:  the case is level (or two readings turned 180° apart on any table, averaged: cancels the table's slope)
//   front: tip the nose down a little once: that tilt shows which way the beam points
namespace imu {
  uint8_t addr = 0;
  volatile bool ok = false, still = false, bumped = false;
  volatile float pitch = 0, roll = 0, bumpDeg = 0;     // ° (pitch + = nose up)
  volatile float pitchS = 0, rollS = 0;                // the same, smoothed over about a third of a second: what the level shows
  static bool shown = false;
  char bumpWhy[12] = "";
  float a[3] = {0, 0, 1};                              // gravity reaction ("up"), filtered, in g
  float gb[3] = {0, 0, 0};                             // gyro bias, °/s (learned while still)
  float up0[3] = {0, 0, 1}, fw[3] = {0, 1, 0};         // level "up" and the beam direction
  bool zeroed = false, fwdSet = false, half = false; float z1[3];
  bool refSet = false; float refP = 0, refR = 0, yaw = 0;
  volatile int cmd = 0; String msg = "";
  enum { C_ZERO = 1, C_ZERO1, C_ZERO2, C_FRONT, C_LOCK, C_CANCEL };
  Preferences store;

  static float dot(const float* p, const float* q) { return p[0] * q[0] + p[1] * q[1] + p[2] * q[2]; }
  static bool norm(float* v) { float L = sqrtf(dot(v, v)); if (L < 1e-6f) return false; for (int i = 0; i < 3; i++) v[i] /= L; return true; }
  // keep the beam direction at right angles to "up"
  static void fixFront() {
    float k = dot(fw, up0); for (int i = 0; i < 3; i++) fw[i] -= k * up0[i];
    if (!norm(fw)) { float y[3] = {0, 1, 0}, x[3] = {1, 0, 0}; memcpy(fw, fabsf(up0[1]) < .9f ? y : x, sizeof fw); k = dot(fw, up0); for (int i = 0; i < 3; i++) fw[i] -= k * up0[i]; norm(fw); }
  }
  static void save() {
    store.putBytes("up", up0, sizeof up0); store.putBytes("fw", fw, sizeof fw);
    store.putBool("zeroed", zeroed); store.putBool("front", fwdSet);
  }
  static bool wr(uint8_t r, uint8_t v) { Wire.beginTransmission(addr); Wire.write(r); Wire.write(v); return Wire.endTransmission() == 0; }
  static bool rd(uint8_t r, uint8_t* b, int n) {
    Wire.beginTransmission(addr); Wire.write(r); if (Wire.endTransmission(false) != 0) return false;
    if (Wire.requestFrom((int)addr, n) != n) return false;
    for (int i = 0; i < n; i++) b[i] = Wire.read();
    return true;
  }
  static bool begin() {
    for (uint8_t ad : {(uint8_t)0x68, (uint8_t)0x69}) {
      addr = ad; uint8_t id = 0;
      if (!rd(0x00, &id, 1) || id != 0xD1) continue;
      wr(0x7E, 0xB6); delay(20);                  // soft reset
      wr(0x7E, 0x11); delay(10);                  // accelerometer on
      wr(0x7E, 0x15); delay(90);                  // gyro on
      wr(0x40, 0x28); wr(0x41, 0x03);             // accel 100 Hz, ±2 g
      wr(0x42, 0x28); wr(0x43, 0x03);             // gyro 100 Hz, ±250 °/s
      delay(20);
      return true;
    }
    addr = 0; return false;
  }
  // the bump alarm's reference: where it points now
  static void lock() { refP = pitch; refR = roll; yaw = 0; refSet = true; bumped = false; bumpDeg = 0; bumpWhy[0] = 0; }
  static void angles(const float* u) {
    float s[3] = {up0[1] * fw[2] - up0[2] * fw[1], up0[2] * fw[0] - up0[0] * fw[2], up0[0] * fw[1] - up0[1] * fw[0]};
    auto as = [](float x) { return asinf(x < -1 ? -1 : x > 1 ? 1 : x) * 57.29578f; };
    pitch = as(dot(u, fw)); roll = as(dot(u, s));
  }
  // a command from the app (run here, in the sensor's own task, so nothing changes mid-reading)
  static void runCmd(int c) {
    float u[3] = {a[0], a[1], a[2]}; norm(u);
    if ((c == C_ZERO || c == C_ZERO1 || c == C_ZERO2 || c == C_FRONT) && !still) { msg = "Hold it still for a second, then try again."; return; }
    if (c == C_ZERO) { memcpy(up0, u, sizeof up0); zeroed = true; half = false; fixFront(); save(); refSet = false; msg = "Zeroed."; }
    else if (c == C_ZERO1) { memcpy(z1, u, sizeof z1); half = true; msg = "Now turn it around 180° on the same spot."; }
    else if (c == C_ZERO2) {
      if (!half) { msg = "Do the first reading first."; return; }
      float d = acosf(fminf(1, dot(z1, u))) * 57.29578f;
      if (d > 8) { msg = "That's tilted a lot more than the first reading. Put it back on the same flat spot."; return; }
      float m[3] = {z1[0] + u[0], z1[1] + u[1], z1[2] + u[2]}; norm(m);
      memcpy(up0, m, sizeof up0); zeroed = true; half = false; fixFront(); save(); refSet = false;
      char b[80]; snprintf(b, sizeof b, "Zeroed. The table was off by %.2f°.", d / 2); msg = b;
    }
    else if (c == C_FRONT) {
      float k = dot(u, up0), d[3] = {u[0] - k * up0[0], u[1] - k * up0[1], u[2] - k * up0[2]};
      float tilt = asinf(fminf(1, sqrtf(dot(d, d)))) * 57.29578f;
      if (tilt < 2) { msg = "Tip the front down a bit more (at least 2°), then tap again."; return; }
      for (int i = 0; i < 3; i++) fw[i] = -d[i];   // nose down: "up" leans away from the front
      norm(fw); fwdSet = true; save(); refSet = false; msg = "Got it: the front is learned.";
    }
    else if (c == C_LOCK) { lock(); msg = "Aim saved."; }
    else if (c == C_CANCEL) { half = false; msg = ""; }
  }

  void task(void*) {
    Wire.begin(PIN_IMU_SDA, PIN_IMU_SCL, 400000);
    store.begin("imu", false);
    if (store.getBytesLength("up") == sizeof up0) { store.getBytes("up", up0, sizeof up0); store.getBytes("fw", fw, sizeof fw); }
    zeroed = store.getBool("zeroed", false); fwdSet = store.getBool("front", false); fixFront();
    uint32_t tryAt = 0, stillSince = 0, lastUs = micros(); int fails = 0; bool first = true;
    for (;;) {
      if (!ok) {
        if (cmd) { msg = "No tilt sensor found: check the BMI160's four wires."; cmd = 0; }
        if (millis() >= tryAt) { ok = begin(); tryAt = millis() + 5000; first = true; fails = 0; }
        vTaskDelay(pdMS_TO_TICKS(50)); continue;
      }
      uint8_t b[12];
      if (!rd(0x0C, b, 12)) { if (++fails > 20) ok = false; vTaskDelay(pdMS_TO_TICKS(10)); continue; }
      fails = 0;
      uint32_t nowUs = micros(); float dt = (nowUs - lastUs) / 1e6f; lastUs = nowUs; if (dt > .1f) dt = .1f;
      float g[3], ac[3];
      for (int i = 0; i < 3; i++) { g[i] = (int16_t)(b[2 * i] | b[2 * i + 1] << 8) / 131.2f; ac[i] = (int16_t)(b[6 + 2 * i] | b[7 + 2 * i] << 8) / 16384.f; }
      if (first) { memcpy(a, ac, sizeof a); first = false; }
      // still: the gyro steady (close to its own running average) and the accelerometer close to its average.
      // v4.17: "steady", not "near zero". A BMI160 can read a few degrees a second while sitting still, and that offset
      // is only learned once it counts as still, so judging it against zero could lock it out for good
      // ("Hold it still for a second" every time, on a table).
      static float gm[3] = {0, 0, 0}; static bool gmSet = false;
      if (!gmSet) { memcpy(gm, g, sizeof gm); gmSet = true; }
      for (int i = 0; i < 3; i++) gm[i] += 0.05f * (g[i] - gm[i]);
      float gd[3] = {g[0] - gm[0], g[1] - gm[1], g[2] - gm[2]};
      float w[3] = {g[0] - gb[0], g[1] - gb[1], g[2] - gb[2]};
      float dev = fabsf(ac[0] - a[0]) + fabsf(ac[1] - a[1]) + fabsf(ac[2] - a[2]);
      bool calm = sqrtf(dot(gd, gd)) < 0.6f && sqrtf(dot(gm, gm)) < 8.0f && dev < 0.03f;
      uint32_t now = millis();
      if (calm) { if (!stillSince) stillSince = now; } else stillSince = 0;
      still = stillSince && now - stillSince > 800;
      // average: slow while still (steady to ~0.05°), quick while it's being moved (follows the tripod head)
      float k = still ? 0.02f : 0.06f;   // was 0.15 while moving: every tremor of the hand on the tripod head showed
      for (int i = 0; i < 3; i++) a[i] += k * (ac[i] - a[i]);
      { static bool gbSet = false;
        if (still && !gbSet) { memcpy(gb, gm, sizeof gb); gbSet = true; }
        else if (still) for (int i = 0; i < 3; i++) gb[i] += 0.01f * (g[i] - gb[i]); }
      float u[3] = {a[0], a[1], a[2]}; norm(u);
      angles(u);
      // the level on the screens: calmer still, so the bubble glides instead of twitching (the bump alarm uses the quick ones)
      if (!shown) { pitchS = pitch; rollS = roll; shown = true; }
      else { float ks = 1 - expf(-dt / 0.35f); pitchS = pitchS + ks * (pitch - pitchS); rollS = rollS + ks * (roll - rollS); }
      // turning left/right shows up only in the gyro: add up turns bigger than the noise
      float wy = dot(w, u);
      if (refSet && fabsf(wy) > 0.3f) yaw += wy * dt;
      // bump alarm: once it has settled again, compare with where it was aimed
      if (refSet && still) {
        float dp = fabsf(pitch - refP), dr = fabsf(roll - refR), dy = fabsf(yaw);
        if (dp > BUMP_PITCH || dr > BUMP_ROLL || dy > BUMP_YAW) {
          bumped = true;
          if (dy * 0.5f > dp && dy > BUMP_YAW) { bumpDeg = dy; strlcpy(bumpWhy, "turned", sizeof bumpWhy); }
          else if (dp >= dr * 0.3f) { bumpDeg = pitch - refP; strlcpy(bumpWhy, "tilted", sizeof bumpWhy); }
          else { bumpDeg = dr; strlcpy(bumpWhy, "leaned", sizeof bumpWhy); }
        }
      }
      if (cmd) { runCmd(cmd); cmd = 0; }
      vTaskDelay(pdMS_TO_TICKS(10));
    }
  }
  // from a web request: hand the command to the task and wait for its answer
  String command(int c) {
    msg = ""; cmd = c;
    for (int i = 0; i < 60 && cmd; i++) delay(10);
    return msg;
  }
}
