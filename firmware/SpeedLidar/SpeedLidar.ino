static const char* resetName(esp_reset_reason_t r) {
  switch (r) {
    case ESP_RST_POWERON: case ESP_RST_EXT: return "power";       // power came on (or the reset button)
    case ESP_RST_BROWNOUT: return "brownout";                     // the power dipped too low
    case ESP_RST_PANIC: return "crash";
